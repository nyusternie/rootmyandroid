<!-- Status-bar / notification icon: exchange arrows (⇄) — the relay in one
     glyph: bytes go out, bytes come back. Replaces the terminal prompt
     ("> _") on the owner's call (2026-11-26). Monochrome by design: Android
     tints status-bar icons, so any colour is flattened to a white
     silhouette. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- top arrow, pointing right -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4.4,7.3 L15.2,7.3 L15.2,5.3 L19.6,9 L15.2,12.7 L15.2,10.7 L4.4,10.7 Z" />
    <!-- bottom arrow, pointing left -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M19.6,13.3 L8.8,13.3 L8.8,11.3 L4.4,15 L8.8,18.7 L8.8,16.7 L19.6,16.7 Z" />
</vector>
