<?xml version="1.0" encoding="utf-8"?>
<!-- apps/rootz/app/src/main/res/drawable/rootz_notif.xml -->
<!-- Status-bar / notification icon: a terminal prompt ("> _") — the Rootz
     identity in one glyph. Monochrome by design: the system tints status-bar
     icons, so any colour here would be flattened to a white silhouette
     anyway (Android notification-icon rule). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- ">" chevron -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M5.6,5.4 L8.3,5.4 L15.6,12 L8.3,18.6 L5.6,18.6 L12.9,12 Z" />
    <!-- "_" cursor -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M13.6,15.8 L19.2,15.8 L19.2,18.2 L13.6,18.2 Z" />
</vector>
