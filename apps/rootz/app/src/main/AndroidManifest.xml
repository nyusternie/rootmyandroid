<?xml version="1.0" encoding="utf-8"?>
<!-- apps/rootz/app/src/main/AndroidManifest.xml -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The MVP talks to the rootzd daemon bridge over localhost TCP. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Same-device wireless-ADB pairing runs from a notification's inline
         reply (foregrounding this activity kills the Settings pairing
         server). Android 13+ blocks notifications without this runtime
         grant, so the arm button requests it (targetSdk 36). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="Rootz"
        android:icon="@drawable/rootz_icon"
        android:theme="@style/Theme.Rootz"
        android:allowBackup="false"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Inline-reply target for notification-based same-device pairing.
             Exported so adb shell can also drive it directly (development
             hook: am broadcast with a pair_code string extra — pairs
             headless without foregrounding anything). -->
        <receiver
            android:name=".PairingReplyReceiver"
            android:exported="true" />
        <!-- Shares exported scrollback .txt files from cacheDir/exports
             (Terminal Editor export) — no storage permission needed. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
