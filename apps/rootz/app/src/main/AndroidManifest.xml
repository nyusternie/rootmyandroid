<?xml version="1.0" encoding="utf-8"?>
<!-- apps/rootz/app/src/main/AndroidManifest.xml -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The MVP talks to the rootzd daemon bridge over localhost TCP. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Same-device wireless-ADB pairing runs from a notification's inline
         reply (foregrounding this activity kills the Settings pairing
         server). Android 13+ blocks notifications without this runtime
         grant, so the arm button requests it (targetSdk 36). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The relay daemon runs in a foreground service so the lane survives
         backgrounding and reboots (owner order 2026-11-25). specialUse is
         the honest type: a user-visible, user-started tunnel, not a data
         sync with a 6-hour cap on Android 15. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- BootReceiver restarts the lane after BOOT_COMPLETED / app update. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="Rootz"
        android:icon="@drawable/rootz_icon"
        android:theme="@style/Theme.Rootz"
        android:allowBackup="false"
        android:supportsRtl="true">
        <!-- The launcher entry is the ALIAS, not the activity: disabling
             .LauncherAlias removes the icon from the drawer while the app
             (and the relay service) keeps running — the same mechanism the
             Guardian Angel app uses (docs/TODO-2026-11-25-icon-removal.md,
             owner picked option A on 2026-11-25). MainActivity stays
             exported for explicit starts (adb, the pairing hook). -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:exported="true" />
        <activity-alias
            android:name=".LauncherAlias"
            android:targetActivity=".MainActivity"
            android:label="Rootz"
            android:icon="@drawable/rootz_icon"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- Foreground host for the relay daemon (survives backgrounding and
             reboots). Started by the app or by BootReceiver. -->
        <service
            android:name=".RelayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-paired relay tunnel for the Root My Android web terminal; runs only while an account is paired and is visible as an ongoing notification." />
        </service>
        <!-- Restarts the relay lane after a reboot or an app update. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Inline-reply target for notification-based same-device pairing.
             Exported so adb shell can also drive it directly (development
             hook: am broadcast with a pair_code string extra — pairs
             headless without foregrounding anything). -->
        <receiver
            android:name=".PairingReplyReceiver"
            android:exported="true" />
        <!-- Shares exported scrollback .txt files from cacheDir/exports
             (Terminal Editor export) — no storage permission needed. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
