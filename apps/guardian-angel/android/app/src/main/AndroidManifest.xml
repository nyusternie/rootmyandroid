<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Installed-app inventory (owner-approved first monitoring slice,
         2026-11-25): package names/labels/versions only, no SMS, no call
         log, no browser history. QUERY_ALL_PACKAGES is what makes the full
         list visible on Android 11+; it is Play-policy-restricted, which is
         acceptable for the F-Droid/sideload distribution this app uses. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- The notification is the only entry point (option B); it is re-posted
         at boot, so the receiver needs this. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android 13+ needs this runtime grant or the entry-point
         notification never appears. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
      </activity>
      <!-- NO launcher entry (owner order 2026-11-25, option B). The app is
           opened from its notification (GuardianNotifier), the installer's
           Open button, or adb: am start -n com.rootmyandroid.guardian_angel/.MainActivity -->
      <!-- Re-posts the entry-point notification after a reboot / update. -->
      <receiver
        android:name=".BootReceiver"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.BOOT_COMPLETED" />
            <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        </intent-filter>
      </receiver>
      <receiver
        android:name=".GuardianAdminReceiver"
        android:label="@string/app_name"
        android:description="@string/device_admin_description"
        android:permission="android.permission.BIND_DEVICE_ADMIN"
        android:exported="true">
        <meta-data
          android:name="android.app.device_admin"
          android:resource="@xml/device_admin_policies" />
        <intent-filter>
            <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
        </intent-filter>
      </receiver>
    </application>
</manifest>
