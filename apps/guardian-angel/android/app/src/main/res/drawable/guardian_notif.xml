<?xml version="1.0" encoding="utf-8"?>
<!-- apps/guardian-angel/android/app/src/main/res/drawable/guardian_notif.xml -->
<!-- Status-bar / notification icon: the halo (owner order 2026-11-26) —
     the Guardian Angel's own emblem, and the one mark that still reads at
     status-bar size (~18dp). Monochrome by design: Android tints status-bar
     icons, so any colour is flattened to a white silhouette — which is also
     why this is a vector and not the 😇 glyph: an emoji is a colour bitmap
     and VectorDrawable has no <text>.
     A single ring, nothing else: sparkles and a face turn to mush at 18dp
     (checked in a 24dp rasterisation), and a bare ring is the shape the
     emoji's halo is recognised by. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:pathData="M3.9,12 a8.1,4.7 0 1,0 16.2,0 a8.1,4.7 0 1,0 -16.2,0 Z" />
</vector>
