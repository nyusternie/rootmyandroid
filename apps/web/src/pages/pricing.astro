---
// src/pages/pricing.astro — the three Halo levels (single/double/triple).
// Prices + structure owner-decided 2026-11-04 (HANDOFF.md §10.2): Basic
// 1 Halo/mo, Elite 2 Halo/mo (cumulative), Pro 3 Halo/YEAR — an
// independent pro lane (Terminal Editor, Log Analysis) that combines with
// a monthly plan or stands alone. No Offer/PriceSpecification schema on
// purpose: structured data must mirror real, visible copy.
import Base from '../layouts/Base.astro'

const tiers = [
  {
    badge: '/img/badge-halo-single.webp',
    alt: 'Single Halo level badge — android robot with one halo',
    name: 'Single Halo',
    level: 'Basic',
    price: '1 Halo',
    per: 'month · $5',
    features: [
      'Read installed apps',
      'Read messages',
      'Read call logs',
      'Renews every 30 days',
    ],
    cta: { href: '/halo', label: 'Top up Halo' },
    featured: false,
  },
  {
    badge: '/img/badge-halo-double.webp',
    alt: 'Double Halo level badge — android robot with two halos',
    name: 'Double Halo',
    level: 'Elite',
    price: '2 Halos',
    per: 'month · $10',
    features: [
      'Everything in Basic',
      'View photos & media',
      'View camera & video',
      'Renews every 30 days',
    ],
    cta: { href: '/halo', label: 'Top up Halo' },
    featured: true,
  },
  {
    badge: '/img/badge-halo-triple.webp',
    alt: 'Triple Halo level badge — android robot with three halos',
    name: 'Triple Halo',
    level: 'Pro',
    price: '3 Halos',
    per: 'year · $15',
    features: [
      'Terminal Editor',
      'Log Analysis',
      'Independent yearly unlock',
      'Combines with Basic or Elite — or stands alone',
    ],
    cta: { href: '/halo', label: 'Top up Halo' },
    featured: false,
  },
]
---

<Base
  title="Pricing"
  description="Three Halo levels — Basic and Elite monthly, Pro yearly. One account number, one Halo balance, no email and no password."
>
  <section class="container" style="padding: 3rem 0 2rem; text-align: center">
    <h1>Three levels. <span class="hl">One balance.</span></h1>
    <p class="lede" style="max-width: 46rem; margin: 0 auto">
      Every level runs on the same privacy-first account — no email, no
      password, just your account number. Paid levels are drawn from your
      Halo balance.
    </p>
  </section>

  <section class="container" style="padding-bottom: 3rem">
    <div class="grid-3 tiers-grid">
      {tiers.map((t) => (
        <div class:list={['panel', 'tier-card', { featured: t.featured }]}>
          {t.featured && <span class="tier-tag">Recommended</span>}
          <img
            class="app-badge"
            src={t.badge}
            alt={t.alt}
            width="256"
            height="256"
            loading="lazy"
          />
          <h2>{t.name}</h2>
          <p class="tier-level muted">{t.level}</p>
          <p class="tier-price">
            {t.price} <span class="muted">/ {t.per}</span>
          </p>
          <ul class="tier-features">
            {t.features.map((f) => <li>{f}</li>)}
          </ul>
          <a class:list={['btn', { 'btn-primary': t.featured }]} href={t.cta.href}>
            {t.cta.label}
          </a>
        </div>
      ))}
    </div>
    <p class="muted" style="margin-top: 1.5rem; text-align: center">
      Halo base rate: $5 = 1 Halo — packs <code>halo_1</code> / <code>halo_4</code>
      / <code>halo_6</code>, see <a href="/halo">Halo</a>. Basic and Elite renew every
      30 days; Pro renews yearly and works with or without a monthly plan.
      Device scanning stays free — no account needed.
    </p>
  </section>

  <style>
    .tiers-grid {
      align-items: stretch;
    }
    .tier-card {
      text-align: center;
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
    .tier-card.featured {
      border-color: var(--accent, #3d9df2);
    }
    .tier-tag {
      position: absolute;
      top: -0.75rem;
      left: 50%;
      transform: translateX(-50%);
      background: var(--accent, #3d9df2);
      color: #0d0f12;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      padding: 0.2rem 0.75rem;
      border-radius: 999px;
    }
    .tier-level {
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-size: 0.8rem;
      margin: 0;
    }
    .tier-price {
      font-size: 1.75rem;
      font-weight: 700;
      margin: 0.5rem 0 0;
    }
    .tier-price .muted {
      font-size: 0.9rem;
      font-weight: 400;
    }
    .tier-features {
      list-style: none;
      padding: 0;
      margin: 0.75rem 0 1.25rem;
      display: grid;
      gap: 0.4rem;
    }
    .tier-features li::before {
      content: '✓ ';
      color: #3fb96b;
      font-weight: 700;
    }
    .tier-card .btn {
      margin-top: auto;
    }
  </style>
</Base>
