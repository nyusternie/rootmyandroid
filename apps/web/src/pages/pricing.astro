---
// src/pages/pricing.astro — TWO products (owner rulings 2026-11-05):
//   Guardian Angel — monthly monitoring subscriptions (Lite / Pro)
//   Rootz — professional tools; "Pro" is its 1-YEAR subscription
// Plans are top-up subscriptions (Mullvad-style): add time anytime, no
// auto-renew, no stored card; Guardian Angel subscribers can switch Lite <-> Pro.
// The free core (browser scan etc.) sits OUTSIDE both products.
// Offer schema (below) mirrors the visible tier cards exactly — it is
// BUILT from the same tier arrays that render the cards, so copy and
// structured data cannot drift. Listed fiat prices ONLY: the 15% crypto
// discount is enforced server-side and is NEVER hard-coded in clients
// (AGENTS.md). Owner ruling 2026-11-07.
import Base from '../layouts/Base.astro'

const guardianTiers = [
  {
    badge: '/img/badge-halo-single.webp',
    alt: 'Guardian Angel Lite badge — android robot with one halo',
    name: 'Guardian Angel',
    level: 'Lite',
    price: '$5',
    per: 'month',
    features: [
      'Read installed apps',
      'Read messages',
      'Cover up to 5 devices',
      '30 days per top-up — add time anytime',
    ],
    cta: { href: '/account', label: 'Subscribe' },
    tag: null,
    featured: false,
  },
  {
    badge: '/img/badge-halo-double.webp',
    alt: 'Guardian Angel Pro badge — android robot with two halos',
    name: 'Guardian Angel Pro',
    level: 'Pro',
    price: '$15',
    per: 'month',
    features: [
      'Everything in Guardian Angel Lite',
      'Read call logs',
      'View photos & media',
      'View camera & video',
      'Switch between Lite and Pro anytime',
    ],
    cta: { href: '/account', label: 'Subscribe' },
    tag: 'Recommended',
    featured: true,
  },
]

const rootzTiers = [
  {
    badge: '/img/brand/guru-staff.webp',
    alt: 'Colonel Rewt — wise old android robot, staff bearing the SU emblem',
    name: 'Rootz',
    level: 'Pro',
    price: '$15',
    per: 'year',
    features: [
      'Terminal Editor',
      'Log Analysis',
      'Independent yearly subscription',
      'Combines with any Guardian Angel plan — or stands alone',
    ],
    cta: { href: '/account', label: 'Subscribe' },
    tag: 'New',
    featured: true,
  },
]

// Every sentence appended to the descriptions is (near-)verbatim visible
// copy: the features come from the cards; the top-up/crypto sentences come
// from the footer note at the bottom of this page.
type Tier = (typeof guardianTiers)[number]
const offerFromTier = (t: Tier, position: number) => ({
  '@type': 'Offer',
  position,
  name: `${t.name} ${t.level}`,
  price: t.price.replace('$', ''),
  priceCurrency: 'USD',
  url: 'https://rootmyandroid.com/pricing',
  description: `${t.features.join('. ')}. Top-up subscription: add time anytime — no auto-renew, no stored card. Pay with crypto and save 15%.`,
})
const pricingSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Root My Android plans and pricing',
  itemListElement: [
    {
      '@type': 'Offer',
      position: 1,
      name: 'Free',
      price: '0',
      priceCurrency: 'USD',
      url: 'https://rootmyandroid.com/pricing',
      description:
        'Browser device scan (read-only ADB), bootloader & unlock detection, root-method selection, and the full guides library — no account needed.',
    },
    ...[...guardianTiers, ...rootzTiers].map((t, i) => offerFromTier(t, i + 2)),
  ],
}
---

<Base
  title="Pricing"
  description="Guardian Angel monitoring (Lite $5/mo, Pro $15/mo) and Rootz Pro professional tools ($15/yr). Top-up subscriptions — no email, no password, no auto-renew."
>
  <section class="container px-0 pt-12 pb-8 text-center">
    <h1>Two products. <span class="hl text-accent">Simple subscriptions.</span></h1>
    <p class="lede mx-auto my-0 max-w-[46rem]">
      Guardian Angel watches over your devices with monthly monitoring
      subscriptions. Rootz unlocks professional tooling with a yearly
      Pro subscription. Both run on the same privacy-first account — no
      email, no password, just your account number. Add time with a
      top-up whenever you like — no auto-renew, no stored card.
    </p>
  </section>

  <section class="container pb-10">
    <div class="panel free-strip flex flex-wrap items-center justify-between gap-4">
      <div>
        <h2 class="m-0">Free <span class="muted free-price text-[1rem] font-normal">$0 forever</span></h2>
        <p class="muted mt-1 max-w-[40rem]">
          Browser device scan (read-only ADB), bootloader &amp; unlock
          detection, root-method selection, and the full guides library —
          no account needed.
        </p>
      </div>
      <a class="btn" href="/scan">Start free</a>
    </div>
  </section>

  <section class="container pb-10">
    <h2 class="product-head mb-5 text-center">Guardian Angel <span class="muted">— monthly monitoring</span></h2>
    <div class="tiers-grid tiers-grid-2 grid grid-cols-1 items-stretch gap-[0.9rem] min-[560px]:mx-auto min-[560px]:max-w-[46rem] min-[560px]:grid-cols-2">
      {guardianTiers.map((t) => (
        <div class:list={['panel', 'tier-card', 'relative flex flex-col gap-1 text-center', { featured: t.featured, 'border-accent': t.featured }]}>
          {t.tag && <span class="tier-tag absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-accent px-3 py-[0.2rem] text-[0.75rem] font-bold tracking-[0.05em] text-[#0d0f12]">{t.tag}</span>}
          <img
            class="app-badge"
            src={t.badge}
            alt={t.alt}
            width="256"
            height="256"
            loading="lazy"
          />
          <h3>{t.name}</h3>
          <p class="tier-level muted m-0 text-[0.8rem] uppercase tracking-[0.12em]">{t.level}</p>
          <p class="tier-price mt-2 text-[1.75rem] font-bold">
            {t.price} <span class="muted text-[0.9rem] font-normal">/ {t.per}</span>
          </p>
          <ul class="tier-features mt-3 mb-5 grid list-none gap-[0.4rem] p-0">
            {t.features.map((f) => <li class="before:font-bold before:text-[#3fb96b] before:content-['✓_']">{f}</li>)}
          </ul>
          <a class:list={['btn', 'mt-auto', { 'btn-primary': t.featured }]} href={t.cta.href}>
            {t.cta.label}
          </a>
        </div>
      ))}
    </div>
  </section>

  <section class="container pb-12">
    <h2 class="product-head mb-5 text-center">Rootz <span class="muted">— professional tools, yearly</span></h2>
    <div class="tiers-grid tiers-grid-1 grid grid-cols-1 items-stretch gap-[0.9rem] min-[560px]:grid-cols-[minmax(0,23rem)] min-[560px]:justify-center">
      {rootzTiers.map((t) => (
        <div class:list={['panel', 'tier-card', 'relative flex flex-col gap-1 text-center', { featured: t.featured, 'border-accent': t.featured }]}>
          {t.tag && <span class="tier-tag absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-accent px-3 py-[0.2rem] text-[0.75rem] font-bold tracking-[0.05em] text-[#0d0f12]">{t.tag}</span>}
          <img
            class="app-badge"
            src={t.badge}
            alt={t.alt}
            width="256"
            height="256"
            loading="lazy"
          />
          <h3>{t.name}</h3>
          <p class="tier-level muted m-0 text-[0.8rem] uppercase tracking-[0.12em]">{t.level}</p>
          <p class="tier-price mt-2 text-[1.75rem] font-bold">
            {t.price} <span class="muted text-[0.9rem] font-normal">/ {t.per}</span>
          </p>
          <ul class="tier-features mt-3 mb-5 grid list-none gap-[0.4rem] p-0">
            {t.features.map((f) => <li class="before:font-bold before:text-[#3fb96b] before:content-['✓_']">{f}</li>)}
          </ul>
          <a class:list={['btn', 'mt-auto', { 'btn-primary': t.featured }]} href={t.cta.href}>
            {t.cta.label}
          </a>
        </div>
      ))}
    </div>
    <p class="muted mt-6 text-center">
      All plans are top-up subscriptions: add time whenever you like — no
      auto-renew, no stored card. Guardian Angel subscribers can switch
      between Lite and Pro anytime; Rootz Pro renews yearly and works with
      or without a Guardian Angel plan. Pay with crypto and save 15% —
      lower fees, less administration, passed back to you. Credit card
      checkout launches as soon as our merchant account is approved.
      Feature packages are being finalized — the lineup above is the
      current offer.
    </p>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(pricingSchema)} />

</Base>
