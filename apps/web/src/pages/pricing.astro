---
// src/pages/pricing.astro — TWO products (owner ruling 2026-11-04, HANDOFF §10.2):
//   Guardian Angel — monthly monitoring subscriptions (Basic / Elite)
//   Guru Daemon — professional tools; "Pro" is its 1-YEAR subscription
// The free core (browser scan etc.) sits OUTSIDE both products.
// No Offer/PriceSpecification schema on purpose: structured data must
// mirror real, visible copy.
import Base from '../layouts/Base.astro'

const guardianTiers = [
  {
    badge: '/img/badge-halo-single.webp',
    alt: 'Single Halo level badge — android robot with one halo',
    name: 'Guardian Angel',
    level: 'Basic',
    price: '1 Halo',
    per: 'month · $5',
    features: [
      'Read installed apps',
      'Read messages',
      'Read call logs',
      'Renews every 30 days',
    ],
    cta: { href: '/halo', label: 'Subscribe' },
    tag: null,
    featured: false,
  },
  {
    badge: '/img/badge-halo-double.webp',
    alt: 'Double Halo level badge — android robot with two halos',
    name: 'Guardian Angel Elite',
    level: 'Elite',
    price: '2 Halos',
    per: 'month · $10',
    features: [
      'Everything in Guardian Angel',
      'View photos & media',
      'View camera & video',
      'Renews every 30 days',
    ],
    cta: { href: '/halo', label: 'Subscribe' },
    tag: 'Recommended',
    featured: true,
  },
]

const guruTiers = [
  {
    badge: '/img/brand/hero-superman.webp',
    alt: 'SU superhero android robot — the Guru Daemon Pro mascot',
    name: 'Guru Daemon',
    level: 'Pro',
    price: '3 Halos',
    per: 'year · $15',
    features: [
      'Terminal Editor',
      'Log Analysis',
      'Independent yearly subscription',
      'Combines with any Guardian Angel plan — or stands alone',
    ],
    cta: { href: '/halo', label: 'Subscribe' },
    tag: 'New',
    featured: true,
  },
]
---

<Base
  title="Pricing"
  description="Two products, one balance — Guardian Angel monthly monitoring subscriptions and Guru Daemon Pro professional tools, billed yearly. No email and no password."
>
  <section class="container" style="padding: 3rem 0 2rem; text-align: center">
    <h1>Two products. <span class="hl">One balance.</span></h1>
    <p class="lede" style="max-width: 46rem; margin: 0 auto">
      Guardian Angel watches over your devices with monthly monitoring
      subscriptions. Guru Daemon unlocks professional tooling with a yearly
      Pro subscription. Both run on the same privacy-first account — no
      email, no password, just your account number.
    </p>
  </section>

  <section class="container" style="padding-bottom: 2.5rem">
    <div class="panel free-strip">
      <div>
        <h2 style="margin: 0">Free <span class="muted free-price">$0 forever</span></h2>
        <p class="muted" style="margin: 0.25rem 0 0; max-width: 40rem">
          Browser device scan (read-only ADB), bootloader &amp; unlock
          detection, root-method selection, and the full guides library —
          no account needed.
        </p>
      </div>
      <a class="btn" href="/scan">Start free</a>
    </div>
  </section>

  <section class="container" style="padding-bottom: 2.5rem">
    <h2 class="product-head">Guardian Angel <span class="muted">— monthly monitoring</span></h2>
    <div class="tiers-grid tiers-grid-2">
      {guardianTiers.map((t) => (
        <div class:list={['panel', 'tier-card', { featured: t.featured }]}>
          {t.tag && <span class="tier-tag">{t.tag}</span>}
          <img
            class="app-badge"
            src={t.badge}
            alt={t.alt}
            width="256"
            height="256"
            loading="lazy"
          />
          <h3>{t.name}</h3>
          <p class="tier-level muted">{t.level}</p>
          <p class="tier-price">
            {t.price} <span class="muted">/ {t.per}</span>
          </p>
          <ul class="tier-features">
            {t.features.map((f) => <li>{f}</li>)}
          </ul>
          <a class:list={['btn', { 'btn-primary': t.featured }]} href={t.cta.href}>
            {t.cta.label}
          </a>
        </div>
      ))}
    </div>
  </section>

  <section class="container" style="padding-bottom: 3rem">
    <h2 class="product-head">Guru Daemon <span class="muted">— professional tools, yearly</span></h2>
    <div class="tiers-grid tiers-grid-1">
      {guruTiers.map((t) => (
        <div class:list={['panel', 'tier-card', { featured: t.featured }]}>
          {t.tag && <span class="tier-tag">{t.tag}</span>}
          <img
            class="app-badge"
            src={t.badge}
            alt={t.alt}
            width="256"
            height="256"
            loading="lazy"
          />
          <h3>{t.name}</h3>
          <p class="tier-level muted">{t.level}</p>
          <p class="tier-price">
            {t.price} <span class="muted">/ {t.per}</span>
          </p>
          <ul class="tier-features">
            {t.features.map((f) => <li>{f}</li>)}
          </ul>
          <a class:list={['btn', { 'btn-primary': t.featured }]} href={t.cta.href}>
            {t.cta.label}
          </a>
        </div>
      ))}
    </div>
    <p class="muted" style="margin-top: 1.5rem; text-align: center">
      Halo base rate: $5 = 1 Halo — packs <code>halo_1</code> / <code>halo_4</code>
      / <code>halo_6</code>, see <a href="/halo">Halo</a>. Guardian Angel plans
      renew every 30 days; Guru Daemon Pro renews yearly and works with or
      without a Guardian Angel plan.
    </p>
  </section>

  <style>
    .free-strip {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .free-price {
      font-size: 1rem;
      font-weight: 400;
    }
    .product-head {
      text-align: center;
      margin: 0 0 1.25rem;
    }
    .tiers-grid {
      align-items: stretch;
      display: grid;
      gap: 0.9rem;
      grid-template-columns: 1fr;
    }
    @media (min-width: 560px) {
      .tiers-grid-2 {
        grid-template-columns: repeat(2, 1fr);
        max-width: 46rem;
        margin: 0 auto;
      }
      .tiers-grid-1 {
        grid-template-columns: minmax(0, 23rem);
        justify-content: center;
      }
    }
    .tier-card {
      text-align: center;
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
    .tier-card.featured {
      border-color: var(--accent, #3d9df2);
    }
    .tier-tag {
      position: absolute;
      top: -0.75rem;
      left: 50%;
      transform: translateX(-50%);
      background: var(--accent, #3d9df2);
      color: #0d0f12;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      padding: 0.2rem 0.75rem;
      border-radius: 999px;
    }
    .tier-level {
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-size: 0.8rem;
      margin: 0;
    }
    .tier-price {
      font-size: 1.75rem;
      font-weight: 700;
      margin: 0.5rem 0 0;
    }
    .tier-price .muted {
      font-size: 0.9rem;
      font-weight: 400;
    }
    .tier-features {
      list-style: none;
      padding: 0;
      margin: 0.75rem 0 1.25rem;
      display: grid;
      gap: 0.4rem;
    }
    .tier-features li::before {
      content: '✓ ';
      color: #3fb96b;
      font-weight: 700;
    }
    .tier-card .btn {
      margin-top: auto;
    }
  </style>
</Base>
