---
// src/pages/nitro.astro — Nitro: the energy unit that powers PRO features.
// The balance below is a static example (this is a zero-JS content page);
// real balances are looked up by account number on /account. Pack tiers
// implement the locked pricing model: base rate $5 = 100 Nitro, tiered
// packs, up to 40% off at the top tier.
// Static content page — ships zero JavaScript.
import Base from '../layouts/Base.astro'

// Nitro purchase packs. Base rate is locked at $5 = 100 Nitro; higher tiers
// discount the per-Nitro price, capped at 40% off. These mirror the
// server-side NITRO_PACKS catalog in rootmyandroid-api (src/lib/nitro.js),
// which is authoritative at checkout time.
const PACKS = [
  { price: 5, nitro: 100, off: 0 },
  { price: 20, nitro: 500, off: 20 },
  { price: 30, nitro: 1000, off: 40 },
]
const perNitro = (p: { price: number; nitro: number }) =>
  `$${(p.price / p.nitro).toFixed(3)}`
---

<Base
  title="Nitro"
  description="Nitro is the energy your Root My Android account burns to run PRO features. $5 = 100 Nitro, tiered packs up to 40% off. You only burn Nitro when you use PRO."
>
  <div class="container" style="padding: 3rem 1.25rem">
    <h1 style="margin: 0 0 0.5rem">Nitro</h1>
    <p class="muted">
      Nitro is the energy your account burns to run PRO features — in Rooted
      and Guardian Angel alike. Top up once, then spend it on the PRO actions
      you actually use. No subscription, no daily drain.
    </p>

    <div class="panel">
      <h2>Your balance <span class="small faint">(example)</span></h2>
      <div class="nitro-bar" aria-label="Example Nitro balance: 62 of 100">
        <span class="nitro-label">Nitro</span>
        <span class="nitro-track"><span class="nitro-fill" style="width: 62%"></span></span>
        <span class="nitro-value">62</span>
      </div>
      <p class="small faint">
        Example balance shown for illustration — your real balance is tied to
        your account number. Look it up on the <a href="/account">account page</a>.
      </p>
    </div>

    <div class="panel">
      <h2>How it works</h2>
      <p class="small muted">
        <strong>$5 = 100 Nitro.</strong> That's the base rate. Bigger packs
        discount it — up to 40% off at the top tier.
      </p>
      <p class="small muted">
        <strong>À la carte, not a meter.</strong> Every PRO action has its own
        Nitro cost, shown before it runs — hide a Guardian Angel launcher icon,
        pull encrypted data off a device remotely, fire a PRO Rooted tool.
        You only burn Nitro when you use PRO.
      </p>
      <p class="small muted">
        <strong>One balance, both apps.</strong> The same Nitro powers Rooted
        PRO and Guardian Angel PRO. Your account number is the only credential;
        the balance follows it everywhere.
      </p>
    </div>

    <div class="panel">
      <h2>Buy Nitro</h2>
      <div class="grid-3">
        {
          PACKS.map((p) => (
            <a class="plan" href="/account">
              <div class="price">${p.price}</div>
              <div class="term">{p.nitro.toLocaleString('en-US')} Nitro</div>
              <div class="save">
                {perNitro(p)} / Nitro{p.off > 0 ? ` · ${p.off}% off` : ' · base rate'}
              </div>
            </a>
          ))
        }
      </div>
      <p class="small faint">
        Purchases go through the card / crypto rails on the
        <a href="/account">account page</a> — enter your account number there
        and pick a pack. Nitro lands on your balance once the payment settles.
      </p>
    </div>

    <div class="panel">
      <h2>When Nitro runs out</h2>
      <p class="small muted">
        PRO features — hiding the Guardian Angel launcher icon, remote access to
        on-device encrypted data, and upcoming Rooted tools — pause until you
        top up. Free features (device scan, guides, ROM catalog) keep working,
        and any remaining balance is never lost.
      </p>
    </div>
  </div>
</Base>
