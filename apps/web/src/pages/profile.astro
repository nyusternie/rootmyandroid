---
// src/pages/profile.astro — legacy redirect: /profile -> /account.
// The page was renamed from /profile to /account; this forwards any old
// links without dropping the query string, so the success/cancel notice
// still shows.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0; url=/account/" />
    <link rel="canonical" href="https://rootmyandroid.com/account/" />
    <title>Account — Root My Android</title>
    <script is:inline>
      // Preserve ?paid=1 / ?cancelled=1 (and any other params) on the way to /account.
      window.location.replace('/account/' + window.location.search + window.location.hash)
    </script>
  </head>
  <body>
    <p><a href="/account/">This page has moved to /account</a>.</p>
  </body>
</html>
