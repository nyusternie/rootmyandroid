---
// src/pages/index.astro — landing page.
import Base from '../layouts/Base.astro'

// Landing-only structured data: the product. No Offer here — pricing lives
// on /halo (Offer schema there); schema must mirror visible page copy.
const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Root My Android',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Android',
  url: 'https://rootmyandroid.com',
  description:
    'Scan your Android device over ADB and get an unlocking / upgrade plan matched to your exact model and firmware, and manage your child\'s device with Guardian Angel. No email, no password.',
}
---

<Base
  title="Root My Android"
  description="Android tools for device owners — unlock & customize your device, and manage your child's device with Guardian Angel. No email, no password."
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <h1>Unlock the <span class="hl">FULL</span> power of your Android phone.</h1>
        <p class="lede">
          Scan your Android device right in your browser — private, read-only,
          nothing leaves your computer — and get a clear unlocking &amp;
          upgrade plan. And with Guardian Angel, keep your child's device safe
          under the same privacy-first approach.
        </p>
        <a
          class="btn btn-primary"
          href="/scan"
          style="display: block; margin-top: 1.75rem; padding: 1.5rem 2rem; font-size: 1.75rem; text-align: center; letter-spacing: 0.08em"
          >SCAN NOW</a
        >
        <div class="row" style="margin-top: 1.75rem">
          <a class="btn btn-primary" href="/download">Meet Guardian Angel</a>
          <a class="btn" href="/guides">Browse the guides</a>
        </div>
      </div>
      <div class="hero-art">
        <img
          src="/img/hero-halo.webp"
          alt="Illustration of a blue Android robot with a golden halo above its head and green roots growing from its base — Root My Android"
          width="880"
          height="880"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class="container" style="padding-top: 2.5rem; padding-bottom: 2rem">
    <div class="grid-3 steps-grid">
      <div class="panel step-card">
        <img
          src="/img/step-connect.webp"
          alt="Illustration of an Android phone connected by USB cable to a laptop"
          width="480"
          height="480"
          loading="lazy"
        />
        <div class="step-body">
          <h2>1. Connect your device</h2>
          <p class="muted">
            Plug in over USB and start a scan right from your browser — no
            installs, no sign-up.
          </p>
        </div>
      </div>
      <div class="panel step-card">
        <img
          src="/img/step-scan.webp"
          alt="Illustration of a magnifying glass scanning an Android phone screen with a small padlock, symbolizing a private local scan"
          width="480"
          height="480"
          loading="lazy"
        />
        <div class="step-body">
          <h2>2. Scan locally</h2>
          <p class="muted">
            The scan runs on your computer over ADB and is read-only:
            bootloader status, current build, and which root methods and ROMs
            actually work on it. Nothing is uploaded.
          </p>
        </div>
      </div>
      <div class="panel step-card">
        <img
          src="/img/step-plan.webp"
          alt="Illustration of a clipboard checklist with a small rocket launching from it"
          width="480"
          height="480"
          loading="lazy"
        />
        <div class="step-body">
          <h2>3. Unlock your phone</h2>
          <p class="muted">
            A step-by-step unlocking / upgrade plan matched to your exact device
            and firmware — not a generic forum thread.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="container" style="padding-bottom: 2rem">
    <h2>Two apps, one account number</h2>
    <div class="grid-2 apps-grid" style="margin-top: 1.5rem">
      <div class="panel">
        <img
          class="app-badge"
          src="/img/badge-halo-single.webp"
          alt="Rooted app icon — android robot with a halo"
          width="256"
          height="256"
          loading="lazy"
        />
        <h2>Rooted</h2>
        <p class="muted">
          The unlocking assistant for your own device. Scan over ADB, check the
          bootloader, and follow a plan matched to your exact model and
          firmware.
        </p>
        <a class="btn" href="/scan">Scan your device</a>
        <p class="muted" style="margin-top: 0.75rem">
          New to rooting? Read the <a href="/rooted">Rooted overview</a> first.
        </p>
      </div>
      <div class="panel">
        <img
          class="app-badge"
          src="/img/badge-guardian.webp"
          alt="Guardian Angel app icon — shield with a heart and a halo"
          width="256"
          height="256"
          loading="lazy"
        />
        <h2>Guardian Angel</h2>
        <p class="muted">
          Parental device-management for your minor children. Installed and
          configured by you on your child's device, it syncs to your account
          number — no child profile is ever created or stored.
        </p>
        <a class="btn" href="/download">Download the apps</a>
      </div>
    </div>
    <p class="muted" style="margin-top: 1.5rem">
      Both apps are covered by our <a href="/terms">Terms of Service</a>,
      including the full
      <a href="/terms">rooting &amp; unlocking risk disclosure</a>.
    </p>
  </section>

  <section class="container">
    <div class="panel">
      <h2>Privacy by design</h2>
      <p class="muted">
        We don't want your email, name, or payment card on file. Payments are
        made in crypto through our payment partner — BTC, ETH, USDT, and
        hundreds of other coins. Either way, your account is only ever a
        number.
      </p>
      <a class="btn" href="/account">Create an account</a>
    </div>
  </section>

  {/* Chat bubble bottom-right on the landing page (owner request 2026-11-04):
      the existing support widget (src/scripts/support.ts) as on the app pages.
      NOTE: / now ships JavaScript — repo rule 4 zero-JS still holds for
      /guides/*; keep the widget off content/guide pages. */}
  <script>
    import '../scripts/support.ts'
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
</Base>

<style>
  /* Hero headline keyword highlight (brand accent). */
  .hl {
    color: var(--color-accent);
  }

  /* Two-column hero on the standard dark theme; the illustration keeps its
     warm cream canvas as a rounded art card. */
  .hero-grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 720px) {
    .hero-grid {
      grid-template-columns: 1.05fr 0.95fr;
    }
  }
  .hero-art img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1.25rem;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
  }

  /* Grids lay panels out side-by-side: the global stacked-panel margin
     (.panel + .panel) must not push grid cards down. */
  .steps-grid .panel + .panel,
  .apps-grid .panel + .panel {
    margin-top: 0;
  }

  /* How-it-works cards: illustration on top, copy below. */
  .step-card {
    padding: 0;
    overflow: hidden;
  }
  .step-card img {
    display: block;
    width: 100%;
    height: auto;
  }
  .step-body {
    padding: 1.25rem 1.5rem 1.5rem;
  }
  .step-body h2 {
    margin: 0 0 0.75rem;
  }
  .step-body p {
    margin: 0;
  }

  /* App badges on the two-product panels. */
  .app-badge {
    display: block;
    width: 72px;
    height: 72px;
    border-radius: 1rem;
    margin-bottom: 1rem;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.4);
  }
</style>
