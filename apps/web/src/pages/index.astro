---
// src/pages/index.astro — landing page.
import Base from '../layouts/Base.astro'

// Landing-only structured data: the product + the FAQ. No Offer here —
// pricing and its Offer schema live on /pricing; schema must mirror
// visible copy.
const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Root My Android',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Android',
  url: 'https://rootmyandroid.com',
  description:
    "Release your Android's full power: a free in-browser device scan with a rooting plan, the Rootz power-user toolkit, and Guardian Angel parental device management.",
}

// FAQ entries render visibly in the <details> list below AND feed the FAQPage
// JSON-LD — the two must stay text-identical (structured data mirrors copy).
const faqs = [
  {
    q: 'What does it mean to root an Android phone?',
    a: 'Rooting gives you superuser (root) access to your own Android device — the same level of control the system itself has. With root access you can remove pre-installed bloatware, install custom ROMs, run a real firewall, and use powerful tools that stock Android blocks.',
  },
  {
    q: 'Why should I root my Android?',
    a: 'The two benefits our users care about most are firewall protection — deciding exactly which apps may talk to the internet — and a system-wide ad blocker that works in every app, not just the browser. Rooting also lets you debloat the phone, tune performance, and back up anything.',
  },
  {
    q: 'What is Rootz?',
    a: 'Rootz is our power-user toolkit for your own device. The free tier includes a system profiler, a task manager and automation, a logcat reader, a firewall manager, a battery monitor, a terminal editor, a file explorer and manager, an APK installer, and a key mapper. Rootz Pro adds an AI harness, a logcat analyzer, an archive manager, and VNC, RDP and more.',
  },
  {
    q: 'What is Guardian Angel?',
    a: "Guardian Angel is our parental device-management app: you install and configure it on your child's device yourself. The free tier includes short-term usage statistics of every app, a DNS-based ad blocker, and cleanup and maintenance. Paid tiers add long-term usage statistics, a screen recorder, a device locator, and an app lock.",
  },
  {
    q: 'Do I need to install anything to scan my phone?',
    a: 'No. The scan runs entirely in a WebUSB-capable desktop browser: connect your Android device with a USB cable and the scan talks to it over ADB. There is nothing to install on your computer or your phone.',
  },
  {
    q: 'Does the scan change anything on my phone?',
    a: 'No. The scan is strictly read-only: it reads device properties (brand, build, bootloader and root indicators) over ADB and never writes, flashes, or modifies anything. Nothing leaves your computer unless you explicitly save the report to an account number.',
  },
  {
    q: 'Do I need an account to scan?',
    a: 'No. The device scan is free and works without an account, an email, or a password. A Mullvad-style account number is only needed if you want to save your scan report or subscribe to a plan.',
  },
  {
    q: 'Does rooting void my warranty?',
    a: "It can. Unlocking the bootloader may void the manufacturer's warranty depending on the manufacturer and your jurisdiction, and unlocking factory-resets the device — so back up first. Our Terms of Service include the full rooting & unlocking risk disclosure.",
  },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}
---

<Base
  title="Release Your FULL Power"
  description="Release your Android's full power — free in-browser root scan, the Rootz power-user toolkit, and Guardian Angel parental controls with usage stats, ad blocking, screen recorder & more."
>
  <section class="hero relative before:pointer-events-none before:absolute before:inset-x-0 before:-top-24 before:h-[32rem] before:bg-[radial-gradient(60%_70%_at_70%_30%,rgba(61,220,132,0.14),transparent_70%)] before:content-['']">
    <div class="container hero-grid relative grid items-center gap-8 min-[720px]:grid-cols-[1.05fr_0.95fr]">
      <div>
        <h1>Root My Android — release your <span class="hl text-accent">FULL</span> power.</h1>
        <p class="lede">
          Rooting your Android phone unlocks the control the manufacturer
          kept for itself. Scan your device right in your browser — private,
          read-only, nothing leaves your computer — follow a rooting plan
          matched to your exact model, then put that power to work with our
          two apps: <a href="/rootz"><strong>Rootz</strong></a> and
          <a href="/guardian-angel"><strong>Guardian Angel</strong></a>.
        </p>
        <a
          class="btn btn-primary mt-7 block px-8 py-6 text-center text-[1.75rem] tracking-[0.08em]"
          href="/scan"
          >SCAN NOW</a
        >
        <div class="row mt-7">
          <a class="btn btn-primary" href="/download">Meet Guardian Angel</a>
          <a class="btn" href="/guides">Browse the guides</a>
        </div>
      </div>
      <div class="hero-art">
        <img class="block h-auto w-full rounded-[1.25rem] shadow-[0_12px_32px_rgba(0,0,0,0.45)]"
          src="/img/hero-halo.webp"
          alt="Illustration of the SU superhero — the green Android robot mascot of Root My Android, wearing a red cape and a yellow SU shield"
          width="880"
          height="880"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class="container pt-10 pb-8">
    <div class="grid-3 steps-grid">
      <div class="panel step-card overflow-hidden p-0">
        <img class="block h-auto w-full"
          src="/img/step-connect.webp"
          alt="Illustration of an Android phone connected by USB cable to a laptop"
          width="480"
          height="480"
          loading="lazy"
        />
        <div class="step-body px-6 pt-5 pb-6">
          <h2 class="mt-0 mb-3">1. Connect your device</h2>
          <p class="muted m-0">
            Plug in over USB and start a scan right from your browser — no
            installs, completely private.
          </p>
        </div>
      </div>
      <div class="panel step-card overflow-hidden p-0">
        <img class="block h-auto w-full"
          src="/img/step-scan.webp"
          alt="Illustration of a magnifying glass scanning an Android phone screen with a small padlock, symbolizing a private local scan"
          width="480"
          height="480"
          loading="lazy"
        />
        <div class="step-body px-6 pt-5 pb-6">
          <h2 class="mt-0 mb-3">2. Scan locally</h2>
          <p class="muted m-0">
            The scan runs on your computer over ADB and is read-only:
            bootloader status, current build, and which root methods and ROMs
            actually work on it. Nothing is uploaded.
          </p>
        </div>
      </div>
      <div class="panel step-card overflow-hidden p-0">
        <img class="block h-auto w-full"
          src="/img/step-plan.webp"
          alt="Illustration of a clipboard checklist with a small rocket launching from it"
          width="480"
          height="480"
          loading="lazy"
        />
        <div class="step-body px-6 pt-5 pb-6">
          <h2 class="mt-0 mb-3">3. Unlock your phone</h2>
          <p class="muted m-0">
            A step-by-step unlocking / upgrade plan matched to your exact device
            and firmware — not a generic forum thread.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="container product-section pt-10 pb-4">
    <div class="feature-row grid items-center gap-8 min-[720px]:grid-cols-[1.05fr_0.95fr]">
      <div class="feature-copy">
        <h2>Why root your Android?</h2>
        <p class="muted">
          Root access — superuser control over your own phone — removes the
          limits the manufacturer shipped with it. You decide what runs, what
          connects, and what stays on your device.
        </p>
        <ul class="checklist mt-3 mb-5 list-none p-0">
          <li class="relative mt-[0.55rem] pl-[1.6rem] before:absolute before:left-0 before:font-bold before:text-accent before:content-['✓']">
            <strong>Firewall protection</strong> — decide exactly which apps
            may reach the internet, app by app.
          </li>
          <li class="relative mt-[0.55rem] pl-[1.6rem] before:absolute before:left-0 before:font-bold before:text-accent before:content-['✓']">
            <strong>Ad blocker</strong> — block ads system-wide, in every app
            and every browser.
          </li>
        </ul>
        <p class="muted">
          Rooting also opens the door to custom ROMs, deep debloating, real
          backups, and automation that stock Android refuses to run. New to
          rooting? Read the <a href="/rooting">rooting guide</a> and our
          <a href="/terms">rooting &amp; unlocking risk disclosure</a> first.
        </p>
      </div>
      <div class="feature-art reveal motion-safe:supports-[animation-timeline:view()]:animate-reveal-in motion-safe:supports-[animation-timeline:view()]:[animation-timeline:view()] motion-safe:supports-[animation-timeline:view()]:[animation-range:entry_0%_entry_60%]">
        <img class="block h-auto w-full rounded-[1.25rem] shadow-[0_12px_32px_rgba(0,0,0,0.45)]"
          src="/img/why-root.webp"
          alt="Illustration of the green SU superhero Android robot projecting a glowing energy shield that blocks sparks from a brick wall — firewall protection and ad blocking with root access"
          width="880"
          height="880"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="container product-section pt-10 pb-4">
    <div class="feature-row feature-row--reverse grid items-center gap-8 min-[720px]:grid-cols-[1.05fr_0.95fr]">
      <div class="feature-copy min-[720px]:order-2">
        <h2>Guardian Angel</h2>
        <p class="muted">
          Parental device management for your family. You install Guardian
          Angel on your child's device and configure it yourself — it runs
          quietly in the background and reports back to you. Start free and
          upgrade when you need more.
        </p>
        <div class="row">
          <a class="btn btn-primary" href="/guardian-angel">Explore Guardian Angel</a>
          <a class="btn" href="/download">Download Guardian Angel</a>
        </div>
      </div>
      <div class="feature-art reveal min-[720px]:order-1">
        <img class="block h-auto w-full rounded-[1.25rem] shadow-[0_12px_32px_rgba(0,0,0,0.45)]"
          src="/img/guardian-angel-phone.webp"
          alt="Illustration of the Guardian Angel — the green Android robot with a golden halo — standing protectively beside a smartphone showing app usage statistics"
          width="880"
          height="880"
          loading="lazy"
        />
      </div>
    </div>
    <div class="tier-grid tier-grid-3 mt-7 grid gap-5 min-[720px]:grid-cols-3">
      <div class="panel tier-card">
        <h3 class="mt-0 mb-1 tracking-[0.1em] text-accent">Guardian Angel FREE</h3>
        <ul class="checklist mt-3 mb-5 list-none p-0">
          <li class="relative mt-[0.55rem] pl-[1.6rem] before:absolute before:left-0 before:font-bold before:text-accent before:content-['✓']">Short-term usage statistics of every app</li>
          <li class="relative mt-[0.55rem] pl-[1.6rem] before:absolute before:left-0 before:font-bold before:text-accent before:content-['✓']">DNS-based ad blocker</li>
          <li class="relative mt-[0.55rem] pl-[1.6rem] before:absolute before:left-0 before:font-bold before:text-accent before:content-['✓']">Cleanup and maintenance</li>
        </ul>
      </div>
      <div class="panel tier-card">
        <h3 class="mt-0 mb-1 tracking-[0.1em] text-accent">Guardian Angel LITE</h3>
        <ul class="checklist mt-3 mb-5 list-none p-0">
          <li class="relative mt-[0.55rem] pl-[1.6rem] before:absolute before:left-0 before:font-bold before:text-accent before:content-['✓']">Long-term usage statistics of every app</li>
          <li class="relative mt-[0.55rem] pl-[1.6rem] before:absolute before:left-0 before:font-bold before:text-accent before:content-['✓']">Screen recorder</li>
          <li class="relative mt-[0.55rem] pl-[1.6rem] before:absolute before:left-0 before:font-bold before:text-accent before:content-['✓']">Device locator</li>
          <li class="relative mt-[0.55rem] pl-[1.6rem] before:absolute before:left-0 before:font-bold before:text-accent before:content-['✓']">App lock</li>
        </ul>
      </div>
      <div class="panel tier-card">
        <h3 class="mt-0 mb-1 tracking-[0.1em] text-accent">Guardian Angel PRO</h3>
        <ul class="checklist mt-3 mb-5 list-none p-0">
          <li class="relative mt-[0.55rem] pl-[1.6rem] before:absolute before:left-0 before:font-bold before:text-accent before:content-['✓']">Long-term usage statistics of every app</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="container product-section pt-10 pb-4">
    <div class="feature-row grid items-center gap-8 min-[720px]:grid-cols-[1.05fr_0.95fr]">
      <div class="feature-copy">
        <h2>Rootz</h2>
        <p class="muted">
          The power-user toolkit for your own device. Everything the stock
          system hides from you — profiling, automation, logs, firewall,
          files, and a real terminal — in one place. The free tier is already
          a full toolbox; Rootz Pro adds the professional instruments.
        </p>
        <div class="row">
          <a class="btn btn-primary" href="/rootz">Explore Rootz</a>
          <a class="btn" href="/download">Download Rootz</a>
        </div>
        <p class="muted mt-3">
          New to rooting? Read the <a href="/rooting">rooting guide</a> first.
        </p>
      </div>
      <div class="feature-art reveal motion-safe:supports-[animation-timeline:view()]:animate-reveal-in motion-safe:supports-[animation-timeline:view()]:[animation-timeline:view()] motion-safe:supports-[animation-timeline:view()]:[animation-range:entry_0%_entry_60%]">
        <img class="block h-auto w-full rounded-[1.25rem] shadow-[0_12px_32px_rgba(0,0,0,0.45)]"
          src="/img/guru-terminal.webp"
          alt="Illustration of Colonel Rewt — the wise green Android robot of Rootz Pro, bearded and robed, holding an SU staff in front of a glowing terminal window — Rootz Pro professional tools"
          width="880"
          height="880"
          loading="lazy"
        />
      </div>
    </div>
    <div class="tier-grid tier-grid-2 mt-7 grid gap-5 min-[720px]:grid-cols-2">
      <div class="panel tier-card">
        <h3 class="mt-0 mb-1 tracking-[0.1em] text-accent">Rootz FREE</h3>
        <ul class="checklist mt-3 mb-5 list-none p-0">
          <li class="relative mt-[0.55rem] pl-[1.6rem] before:absolute before:left-0 before:font-bold before:text-accent before:content-['✓']">System profiler</li>
          <li class="relative mt-[0.55rem] pl-[1.6rem] before:absolute before:left-0 before:font-bold before:text-accent before:content-['✓']">Task manager &amp; automation</li>
          <li class="relative mt-[0.55rem] pl-[1.6rem] before:absolute before:left-0 before:font-bold before:text-accent before:content-['✓']">Logcat reader</li>
          <li class="relative mt-[0.55rem] pl-[1.6rem] before:absolute before:left-0 before:font-bold before:text-accent before:content-['✓']">Firewall manager</li>
          <li class="relative mt-[0.55rem] pl-[1.6rem] before:absolute before:left-0 before:font-bold before:text-accent before:content-['✓']">Battery monitor</li>
          <li class="relative mt-[0.55rem] pl-[1.6rem] before:absolute before:left-0 before:font-bold before:text-accent before:content-['✓']">Terminal editor</li>
          <li class="relative mt-[0.55rem] pl-[1.6rem] before:absolute before:left-0 before:font-bold before:text-accent before:content-['✓']">File explorer / manager</li>
          <li class="relative mt-[0.55rem] pl-[1.6rem] before:absolute before:left-0 before:font-bold before:text-accent before:content-['✓']">APK installer</li>
          <li class="relative mt-[0.55rem] pl-[1.6rem] before:absolute before:left-0 before:font-bold before:text-accent before:content-['✓']">Key mapper</li>
        </ul>
      </div>
      <div class="panel tier-card">
        <h3 class="mt-0 mb-1 tracking-[0.1em] text-accent">Rootz PRO</h3>
        <ul class="checklist mt-3 mb-5 list-none p-0">
          <li class="relative mt-[0.55rem] pl-[1.6rem] before:absolute before:left-0 before:font-bold before:text-accent before:content-['✓']">AI harness</li>
          <li class="relative mt-[0.55rem] pl-[1.6rem] before:absolute before:left-0 before:font-bold before:text-accent before:content-['✓']">Logcat analyzer</li>
          <li class="relative mt-[0.55rem] pl-[1.6rem] before:absolute before:left-0 before:font-bold before:text-accent before:content-['✓']">Archive manager</li>
          <li class="relative mt-[0.55rem] pl-[1.6rem] before:absolute before:left-0 before:font-bold before:text-accent before:content-['✓']">VNC, RDP and more</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="container faq-section pt-10 pb-4">
    <h2>Frequently asked questions</h2>
    {faqs.map((f) => (
      <details class="panel faq-item">
        <summary class="cursor-pointer font-semibold">{f.q}</summary>
        <p class="muted mt-3">{f.a}</p>
      </details>
    ))}
    <p class="muted mt-6">
      Both apps are covered by our <a href="/terms">Terms of Service</a>,
      including the full
      <a href="/terms">rooting &amp; unlocking risk disclosure</a>.
    </p>
  </section>

  {/* AI-agent discovery panel (GEO, 2026-11-07): a direct in-content path
      from / to the machine-readable surface — the /agents explainer and
      the /mcp tool catalog. Facts mirror src/pages/agents.astro (verified
      live 2026-11-07). */}
  <section class="container agents-section pt-4 pb-12">
    <div class="panel agents-panel">
      <h2>Building an AI agent?</h2>
      <p class="muted">
        Root My Android is built to be driven by software, not just visited
        by people. A public REST API and a Model Context Protocol (MCP)
        server expose accounts, subscription plans, card &amp; crypto
        checkout, vouchers, payment status, and human support — no API key,
        no registration, no personal data anywhere.
      </p>
      <div class="row">
        <a class="btn" href="/agents">Read the agent guide</a>
        <a class="btn" href="https://rootmyandroid.com/mcp" rel="noopener">Open the /mcp tool catalog</a>
      </div>
    </div>
  </section>

  {/* Chat bubble bottom-right on the landing page (owner request 2026-11-04):
      the existing support widget (src/scripts/support.ts) as on the app pages.
      NOTE: / now ships JavaScript — repo rule 4 zero-JS still holds for
      /guides/*; keep the widget off content/guide pages. */}
  <script>
    import '../scripts/support.ts'
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Base>

