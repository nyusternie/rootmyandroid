---
// src/pages/model/[...id].astro — individual on-device model profile:
// Hugging Face-verified metadata plus our own measured benchmark history,
// rendered from the `models` content collection. CONTENT page: zero
// JavaScript (AGENTS.md rule 4). The TechArticle JSON-LD (dates) and the
// BreadcrumbList JSON-LD (the "← All models" link) mirror the visible
// copy, exactly as the guides pages do.
import { getCollection, render } from 'astro:content'
import Base from '../../layouts/Base.astro'

export async function getStaticPaths() {
  const models = await getCollection('models', ({ data }) => !data.draft)
  return models.map((model) => ({
    params: { id: model.id },
    props: { model },
  }))
}

const { model } = Astro.props
const { Content } = await render(model)
const d = model.data

const fmtInt = (n: number) => n.toLocaleString('en-US')
const gib = (bytes: number) => (bytes / 2 ** 30).toFixed(2)
const verifiedIso = d.verified.toISOString().slice(0, 10)
const updatedIso = d.updated.toISOString().slice(0, 10)
const canonical = new URL(`/model/${model.id}/`, Astro.site).href
const org = { '@type': 'Organization', name: 'Root My Android', url: Astro.site }
const articleSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: `${d.name} — on-device model profile`,
  description: d.description,
  mainEntityOfPage: canonical,
  author: org,
  publisher: org,
  datePublished: verifiedIso,
  dateModified: updatedIso,
}
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Models',
      item: new URL('/models/', Astro.site).href,
    },
    { '@type': 'ListItem', position: 2, name: d.name, item: canonical },
  ],
}

const cellClass = 'border border-line px-3 py-[0.6rem] align-top'
const headClass =
  'border border-line bg-[#171b21] px-3 py-[0.6rem] align-top text-left'
---

<Base
  title={`${d.name} — On-Device Model Profile, Verified Numbers & Benchmarks`}
  description={d.description}
>
  <link
    slot="head"
    rel="alternate"
    type="text/markdown"
    href={`/model/${model.id}.md`}
    title={`${d.name} (Markdown)`}
  />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <section class="container px-5 pt-12 pb-8">
    <p><a href="/models">← All models</a></p>
    <h1>{d.name}</h1>
    <p class="lede">{d.description}</p>
    <p class="muted">
      Hugging Face data verified <time datetime={verifiedIso}>{verifiedIso}</time>
      {' · '}
      Updated <time datetime={updatedIso}>{updatedIso}</time>
      {' · '}
      <a href={`/model/${model.id}.md`}>View as Markdown</a>
    </p>
  </section>

  <section class="container px-5 pb-8">
    <h2>Verified numbers</h2>
    <p class="muted">
      Every value below was read from the Hugging Face API on the
      verification date — not from marketing pages. Two parameter counts
      and two context lengths are shown because the ecosystem genuinely
      reports both; the prose below the tables explains the differences.
    </p>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full min-w-[42rem] border-collapse text-[0.92rem]">
        <caption class="faint small mb-2 text-left">
          {d.name} — Hugging Face API verification of {verifiedIso}.
        </caption>
        <tbody>
          <tr>
            <th class={headClass} scope="row">Family</th>
            <td class={cellClass}>{d.family}</td>
          </tr>
          <tr>
            <th class={headClass} scope="row">Base repository</th>
            <td class={cellClass}>
              <a href={`https://huggingface.co/${d.hfBase}`}>{d.hfBase}</a>
            </td>
          </tr>
          <tr>
            <th class={headClass} scope="row">GGUF repository</th>
            <td class={cellClass}>
              <a href={`https://huggingface.co/${d.hfGguf}`}>{d.hfGguf}</a>
            </td>
          </tr>
          <tr>
            <th class={headClass} scope="row">License</th>
            <td class={cellClass}>{d.license}</td>
          </tr>
          <tr>
            <th class={headClass} scope="row">Monthly downloads</th>
            <td class={cellClass}>{fmtInt(d.downloadsMonthly)}</td>
          </tr>
          <tr>
            <th class={headClass} scope="row">Parameters (unique, safetensors)</th>
            <td class={cellClass}>{fmtInt(d.paramsUnique)}</td>
          </tr>
          <tr>
            <th class={headClass} scope="row">Parameters (GGUF metadata)</th>
            <td class={cellClass}>
              {d.paramsGguf === null ? 'not extracted' : fmtInt(d.paramsGguf)}
            </td>
          </tr>
          <tr>
            <th class={headClass} scope="row">Native context (config.json)</th>
            <td class={cellClass}>{fmtInt(d.contextTokens)} tokens</td>
          </tr>
          <tr>
            <th class={headClass} scope="row">GGUF-reported context</th>
            <td class={cellClass}>
              {d.contextGguf === null
                ? 'not extracted'
                : `${fmtInt(d.contextGguf)} tokens`}
            </td>
          </tr>
          <tr>
            <th class={headClass} scope="row">Quant</th>
            <td class={cellClass}>{d.quant}</td>
          </tr>
          <tr>
            <th class={headClass} scope="row">GGUF file</th>
            <td class={cellClass}><code>{d.ggufFile}</code></td>
          </tr>
          <tr>
            <th class={headClass} scope="row">GGUF size</th>
            <td class={cellClass}>
              {fmtInt(d.ggufBytes)} bytes = {gib(d.ggufBytes)} GiB
            </td>
          </tr>
          <tr>
            <th class={headClass} scope="row">Catalog tier (free RAM)</th>
            <td class={cellClass}><a href="/models">{d.tier}</a></td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  {
    d.benchmarks.length > 0 && (
      <section class="container px-5 pb-8">
        <h2>Measured benchmarks</h2>
        <p class="muted">
          Run on our own devices under a thermal safety policy (abort at
          Thermal Status ≥ 2, hard-halt ≥ 3, inter-run cooldown to ≤
          50&nbsp;°C). Each entry links the committed raw log — the number
          you see is the number the harness printed.
        </p>
        {d.benchmarks.map((b) => {
          const bIso = b.date.toISOString().slice(0, 10)
          return (
            <div class="mt-6">
              <h3>
                {bIso} — {b.device}
              </h3>
              <p class="faint small">
                {b.toolchain} · <a href={b.log}>raw log</a>
              </p>
              <div class="mt-3 overflow-x-auto">
                <table class="w-full min-w-[42rem] border-collapse text-[0.92rem]">
                  <caption class="faint small mb-2 text-left">
                    {d.name} on {b.device}, {bIso} — mean ± stddev across
                    the harness's repetitions.
                  </caption>
                  <thead>
                    <tr>
                      <th class={headClass} scope="col">Cell</th>
                      <th class={headClass} scope="col">CPU mask</th>
                      <th class={headClass} scope="col">Threads</th>
                      <th class={headClass} scope="col">Test</th>
                      <th class={headClass} scope="col">Tokens/s</th>
                    </tr>
                  </thead>
                  <tbody>
                    {b.cells.flatMap((c) =>
                      c.tests.map((t, i) => (
                        <tr>
                          {i === 0 && (
                            <>
                              <th
                                class={`${cellClass} text-left font-semibold`}
                                scope="row"
                                rowspan={c.tests.length}
                              >
                                {c.name}
                              </th>
                              <td class={cellClass} rowspan={c.tests.length}>
                                <code>{c.mask}</code>
                              </td>
                              <td class={cellClass} rowspan={c.tests.length}>
                                {c.threads}
                              </td>
                            </>
                          )}
                          <td class={cellClass}>{t.name}</td>
                          <td class={cellClass}>
                            {t.tps.toFixed(2)} ± {t.err.toFixed(2)}
                          </td>
                        </tr>
                      )),
                    )}
                  </tbody>
                </table>
              </div>
              {b.notes && <p class="muted mt-3">{b.notes}</p>}
            </div>
          )
        })}
      </section>
    )
  }

  <div class="container prose px-5 pb-12">
    <Content />
  </div>
</Base>
