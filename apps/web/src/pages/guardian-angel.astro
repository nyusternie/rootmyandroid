---
// src/pages/guardian-angel.astro — PRODUCT page for Guardian Angel (the
// parental device-management app). CREATED 2026-11-07 per the
// AI-positioning handoff and owner rulings: (1) ALL product data is
// client-side encrypted — wording mirrors Terms §7 ("encrypted on your
// device before upload; the key is held by you and never by us") and
// Privacy §2/§5; (2) Guardian Angel AI is PLANNED (handoff capability
// matrix: "Guardian activity summaries — planned initially") — labeled, and
// never presented as part of the currently purchasable feature set. Tier
// facts mirror src/pages/pricing.astro (the owner-ruled authority);
// free-tier wording mirrors src/pages/parents.astro and the landing-page
// FAQ — keep all three in sync. FAQ entries render visibly below AND feed
// the FAQPage JSON-LD — the two stay text-identical (structured data
// mirrors copy, same pattern as src/pages/index.astro).
import Base from '../layouts/Base.astro'

const tiers = [
  {
    name: 'Guardian Angel FREE',
    price: '$0',
    per: 'forever',
    features: [
      'Short-term usage statistics of every app',
      'DNS-based ad blocker',
      'Cleanup & maintenance',
    ],
  },
  {
    name: 'Guardian Angel LITE',
    price: '$5',
    per: '30 days',
    features: [
      'Read installed apps',
      'Read messages',
      'Cover up to 5 devices',
      '30 days per top-up — add time anytime',
    ],
  },
  {
    name: 'Guardian Angel PRO',
    price: '$15',
    per: '30 days',
    features: [
      'Everything in Guardian Angel Lite',
      'Read call logs',
      'View photos & media',
      'View camera & video',
      'Switch between Lite and Pro anytime',
    ],
  },
]

const faqs = [
  {
    q: 'What is Guardian Angel?',
    a: "Guardian Angel is our parental device-management app: you install and configure it on your child's device yourself, and it reports back to your private account. The free tier includes short-term usage statistics of every app, a DNS-based ad blocker, and cleanup and maintenance; Lite and Pro add message, app, call-log, and media visibility for up to 5 devices.",
  },
  {
    q: 'Do I need an email or an account?',
    a: 'No email and no password — accounts are Mullvad-style random 16-digit numbers, and the number itself is the credential. Nothing about you or your child is tied to a name, an address, or a phone number.',
  },
  {
    q: 'What do the Lite and Pro plans include?',
    a: 'Lite ($5 / 30 days) reads installed apps and reads messages, covering up to 5 devices per account. Pro ($15 / 30 days) adds call logs, photos & media, and camera & video. Both are top-up subscriptions — no auto-renew, no stored card — and you can switch between Lite and Pro anytime.',
  },
  {
    q: 'Who can read my child\u2019s messages and photos?',
    a: 'Only you. Everything Guardian Angel syncs is encrypted on the device before upload, with a key held by you and never by us — we cannot decrypt your monitoring data. AI summaries, when they ship, use locally filtered and minimized activity data, and message content is only ever processed if that exact category has been separately authorized by you.',
  },
  {
    q: 'Does Guardian Angel AI make decisions about my child?',
    a: 'No. Guardian Angel AI is being built to summarize and explain — group duplicate alerts, categorize app usage, and explain why a rule fired — never to punish, block, diagnose, or contact anyone autonomously. It is a planned feature and is not part of any current plan.',
  },
  {
    q: 'Does paying with crypto save 15%?',
    a: 'Yes — 15% off the listed prices, enforced on our servers, because crypto costs us less in fees and administration. The discount is applied at checkout; the listed fiat prices above never change.',
  },
]

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Guardian Angel',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Android',
  url: 'https://rootmyandroid.com/guardian-angel',
  description:
    "Parental device management for your family: usage statistics, ad blocking, and message, call-log, and media monitoring for up to 5 devices — client-side encrypted, with AI activity summaries in development.",
}
---

<Base
  title="Guardian Angel — parental device management for Android"
  description="Guardian Angel is the privacy-first parental device-management app: usage stats, ad blocking, and message/call-log monitoring on Lite ($5/30 days) and Pro ($15/30 days). Client-side encrypted; AI summaries in development."
>
  <section class="hero relative before:pointer-events-none before:absolute before:inset-x-0 before:-top-24 before:h-[32rem] before:bg-[radial-gradient(60%_70%_at_70%_30%,rgba(61,220,132,0.14),transparent_70%)] before:content-['']">
    <div class="container hero-grid relative grid items-center gap-8 min-[720px]:grid-cols-[1.05fr_0.95fr]">
      <div>
        <h1>Guardian Angel — <span class="hl text-accent">watch over them</span>, without watching everything.</h1>
        <p class="lede">
          Guardian Angel is parental device management for your family. You
          install and configure it on your child&apos;s device yourself, and
          it reports back to your private account — no email, no password,
          and everything encrypted on the device before it leaves. AI
          assistance is being built to turn that activity into calm,
          readable summaries.
        </p>
        <div class="row mt-7">
          <a class="btn btn-primary" href="/download">Download Guardian Angel</a>
          <a class="btn" href="/pricing">See plans &amp; pricing</a>
        </div>
      </div>
      <div class="hero-art">
        <img class="block h-auto w-full rounded-[1.25rem] shadow-[0_12px_32px_rgba(0,0,0,0.45)]"
          src="/img/guardian-angel-phone.webp"
          alt="Illustration of the Guardian Angel — the green Android robot with a golden halo — standing protectively beside a smartphone showing app usage statistics"
          width="880"
          height="880"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class="container pt-10 pb-8">
    <h2>Plans that respect your family</h2>
    <p>
      Start free and upgrade when you need more. Every plan is a top-up
      subscription: add time whenever you like — no auto-renew, no stored
      card — and paying with crypto saves 15%.
    </p>
    <div class="tier-grid tier-grid-3 mt-7 grid gap-5 min-[720px]:grid-cols-3">
      {tiers.map((t) => (
        <div class="panel tier-card">
          <h3 class="mt-0 mb-1 tracking-[0.1em] text-accent">{t.name}</h3>
          <p class="tier-price mt-2 text-[1.75rem] font-bold">
            {t.price} <span class="muted text-[0.9rem] font-normal">/ {t.per}</span>
          </p>
          <ul class="mt-3 mb-0 grid list-none gap-[0.4rem] p-0">
            {t.features.map((f) => (
              <li class="relative pl-[1.6rem] before:absolute before:left-0 before:font-bold before:text-ok before:content-['✓']">{f}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="muted mt-5">
      Feature packages are being finalized — the lineup on our
      <a href="/pricing">pricing page</a> is the current offer.
    </p>
  </section>

  <section class="container pb-8">
    <h2>Client-side encryption — no privacy concerns, by design</h2>
    <p>
      <strong>Everything Guardian Angel syncs is encrypted on your
      child&apos;s device before it leaves, with a key held by you and
      never by us.</strong> Usage statistics, messages, call logs, photos —
      whatever your plan covers, it arrives at our servers as ciphertext
      we cannot decrypt, attached to an account number that identifies no
      one. We cannot read your child&apos;s data, we cannot recover a lost
      key, and there is no personal profile of your child — the only
      records are your account number and the managed device&apos;s
      encrypted data.
    </p>
    <ul>
      <li>No email, no password, no name, no phone number — there is no field to enter them.</li>
      <li>No advertising identifiers or cross-site tracking of any kind.</li>
      <li>No sale, rental, or sharing of your data with anyone.</li>
      <li>
        You install and configure the app yourself; it syncs to your
        account number and nobody else&apos;s.
      </li>
    </ul>
    <p class="muted">
      The full details are in our <a href="/privacy">Privacy Policy</a>,
      including exactly what is stored and why.
    </p>
  </section>

  <section class="container pb-8">
    <h2>Guardian Angel AI <span class="ml-2 inline-block rounded-full border border-line px-2 py-[0.1rem] align-middle text-[0.72rem] font-bold tracking-[0.08em] muted">PLANNED</span></h2>
    <p>
      Guardian Angel AI is on our roadmap and in development — it is not
      part of any plan you can buy today. Its job is to reduce noise, not
      to watch harder: it turns locally filtered activity into summaries a
      parent can actually read, and it explains itself as it goes.
    </p>
    <ul>
      <li><strong>App and usage categorization</strong> — what kind of apps fill your child&apos;s day.</li>
      <li><strong>Duplicate-alert grouping</strong> — one finding instead of fifty notifications.</li>
      <li><strong>Activity summaries</strong> — a parent-readable digest, on your schedule.</li>
      <li><strong>Explanations</strong> — why a rule generated an alert, in plain language.</li>
      <li><strong>Alert-sensitivity recommendations</strong> — tune the rules with reasons, not guesswork.</li>
      <li><strong>Your feedback loop</strong> — mark anything useful, false positive, or ignore similar.</li>
    </ul>

    <h3>Where processing happens — labeled on every screen</h3>
    <p>
      Every AI result carries a visible processing label so you always know
      where your family&apos;s data went:
    </p>
    <ul>
      <li><strong>On device</strong> — filtering and categorization that never leaves the phone.</li>
      <li><strong>Cloud AI — minimized activity data</strong> — aggregates and categories only, sent with your consent.</li>
      <li><strong>Cloud AI — sensitive content</strong> — only if such processing is ever approved, and only with a separate, exact authorization for that category.</li>
      <li><strong>External provider — provider name</strong> — when a third-party model is used, its name is on the label.</li>
    </ul>
    <p>
      Media processing is disabled by default and outside the initial
      release. Raw messages and media are never uploaded by default — AI
      summaries work from locally filtered, minimized activity data.
    </p>

    <h3>You choose, category by category</h3>
    <p>
      Separate controls for separate decisions: local filtering; cloud AI
      summaries; message-content processing, if it is ever supported; media
      processing; provider and model selection where permitted; retention
      and deletion. Revoking cloud processing never deletes your local
      rules — monitoring keeps working on device, exactly as before.
    </p>

    <h3>What Guardian Angel AI will never do</h3>
    <ul>
      <li>Make autonomous disciplinary decisions — punish, block, or contact anyone.</li>
      <li>Diagnose mental health or declare content "safe".</li>
      <li>Silently expand what is monitored.</li>
      <li>Guarantee safety outcomes — it informs parents; it does not replace them.</li>
    </ul>
  </section>

  <section class="container pb-8">
    <h2>How AI usage will be billed</h2>
    <p>
      Your Guardian Angel subscription time and AI usage are separate
      things and will stay separate: the plan, an included AI allowance,
      additional prepaid inference usage, and BYOK usage you pay directly
      to your own provider. Before the first charge you will see the
      feature and task, the provider and model, the estimated maximum
      charge, and a hard session spending cap — and the session stops
      cleanly at that cap.
    </p>
    <p class="panel">
      <strong>Local tools are free. Cloud AI uses your included allowance
      or prepaid AI usage. No automatic overages.</strong> No overdraft, no
      automatic top-up, and the billing history never contains message or
      prompt contents.
    </p>
  </section>

  <section class="container pb-8">
    <h2>Already using built-in controls?</h2>
    <p>
      Guardian Angel adds the monitoring layer on top of Android&apos;s
      built-in controls and Google Family Link — it does not replace them.
      Our <a href="/parents">parental-controls guide</a> walks through all
      three layers and includes a side-by-side comparison so you can
      decide what your family actually needs.
    </p>
  </section>

  <section class="container faq-section pb-12">
    <h2>Frequently asked questions</h2>
    {faqs.map((f) => (
      <details class="panel faq-item mt-3">
        <summary class="cursor-pointer font-semibold">{f.q}</summary>
        <p class="muted mt-3">{f.a}</p>
      </details>
    ))}
    <p class="mt-8">
      <a class="btn btn-primary" href="/download">Download Guardian Angel</a>
      <a class="btn ml-3" href="/pricing">Plans &amp; pricing</a>
    </p>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />

</Base>
