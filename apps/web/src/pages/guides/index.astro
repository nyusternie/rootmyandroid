---
// src/pages/guides/index.astro — guides listing.
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'

const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => (a.data.order ?? 999) - (b.data.order ?? 999)
)
---

<Base title="Guides" description="Step-by-step Android rooting, bootloader, and custom-ROM guides.">
  <div class="container px-5 py-12">
    <h1 class="mt-0 mb-2">Guides</h1>
    <p class="muted">Step-by-step, device-specific. No fluff.</p>

    <div class="stack mt-8">
      {
        guides.map((g) => (
          <a class="panel block text-inherit" href={`/guides/`}>
            <h2 class="mt-0 mb-[0.35rem]">{g.data.title}</h2>
            <p class="muted m-0">
              {g.data.description}
            </p>
          </a>
        ))
      }
    </div>
  </div>
</Base>
