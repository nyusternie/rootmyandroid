---
// src/pages/guides/[...id].astro — render a single guide from the collection.
import { getCollection, render } from 'astro:content'
import Base from '../../layouts/Base.astro'

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data }) => !data.draft)
  return guides.map((guide) => ({
    params: { id: guide.id },
    props: { guide },
  }))
}

const { guide } = Astro.props
const { Content } = await render(guide)

// Freshness + Markdown-alternate signals for search/answer engines: the
// "Published"/"Updated" lines render VISIBLY and the TechArticle JSON-LD
// carries the same dates as datePublished/dateModified (structured data
// mirrors copy); the BreadcrumbList mirrors the "← All guides" link; the
// <link rel="alternate"> in <head> points at the raw-Markdown endpoint
// ([...id].md.ts).
const updatedIso = guide.data.updated
  ? guide.data.updated.toISOString().slice(0, 10)
  : undefined
const publishedIso = guide.data.published
  ? guide.data.published.toISOString().slice(0, 10)
  : undefined
const canonical = new URL(`/guides/${guide.id}/`, Astro.site).href
const org = { '@type': 'Organization', name: 'Root My Android', url: Astro.site }
const guideSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: guide.data.title,
  description: guide.data.description,
  mainEntityOfPage: canonical,
  author: org,
  publisher: org,
  ...(updatedIso ? { dateModified: updatedIso } : {}),
  ...(publishedIso ? { datePublished: publishedIso } : {}),
}

// Mirrors the visible "← All guides" breadcrumb link rendered below.
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Guides',
      item: new URL('/guides/', Astro.site).href,
    },
    { '@type': 'ListItem', position: 2, name: guide.data.title, item: canonical },
  ],
}
---

<Base title={guide.data.title} description={guide.data.description}>
  <link
    slot="head"
    rel="alternate"
    type="text/markdown"
    href={`/guides/${guide.id}.md`}
    title={`${guide.data.title} (Markdown)`}
  />
  <div class="container prose" style="padding: 3rem 1.25rem">
    <p><a href="/guides">← All guides</a></p>
    <h1>{guide.data.title}</h1>
    {(publishedIso || updatedIso) && (
      <p class="muted">
        {publishedIso && (
          <>
            Published <time datetime={publishedIso}>{publishedIso}</time>
          </>
        )}
        {publishedIso && updatedIso && ' · '}
        {updatedIso && (
          <>
            Updated <time datetime={updatedIso}>{updatedIso}</time>
          </>
        )}
        {' · '}
        <a href={`/guides/${guide.id}.md`}>View as Markdown</a>
      </p>
    )}
    <Content />
    <script type="application/ld+json" set:html={JSON.stringify(guideSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </div>
</Base>
