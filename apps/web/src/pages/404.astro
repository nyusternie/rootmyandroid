---
// src/pages/404.astro — 404 page. Astro static build emits /404.html;
// Cloudflare Pages serves it with a real 404 status for unmatched paths
// (fixes the site-wide soft-404 where unknown URLs returned 200 + /).
import Base from '../layouts/Base.astro'
---

<Base
  title="Page not found"
  description="This page does not exist — but your Android's full potential is one scan away."
>
  <section class="container px-0 py-16 text-center">
    <img
      src="/img/brand/su-lost-404.webp"
      alt="The SU robot mascot looking puzzled, scratching its head while holding a disconnected USB cable — this page could not be found"
      width="512"
      height="512"
      fetchpriority="high"
      class="mx-auto mb-6 h-auto w-[280px]"
    />
    <h1 class="mb-2 text-[4rem]">404</h1>
    <p class="lede">
      That page wandered off the ROM. Let's get you back to familiar ground.
    </p>
    <div class="row mt-8 justify-center">
      <a class="btn btn-primary" href="/">Back to the homepage</a>
      <a class="btn" href="/scan">Scan your device</a>
      <a class="btn" href="/guides">Browse the guides</a>
    </div>
  </section>
</Base>
