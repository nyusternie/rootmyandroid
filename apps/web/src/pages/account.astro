---
// src/pages/account.astro — legacy redirect: /account -> /profile.
// The API's hosted-checkout return URLs point at /account/?paid=1 (and
// ?cancelled=1); this page forwards them to /profile without dropping the
// query string, so the success/cancel notice still shows.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0; url=/profile/" />
    <link rel="canonical" href="https://rootmyandroid.com/profile/" />
    <title>Profile — Root My Android</title>
    <script is:inline>
      // Preserve ?paid=1 / ?cancelled=1 (and any other params) on the way to /profile.
      window.location.replace('/profile/' + window.location.search + window.location.hash)
    </script>
  </head>
  <body>
    <p><a href="/profile/">This page has moved to /profile</a>.</p>
  </body>
</html>
