---
// src/pages/account.astro — account: account number creation + buy Halo.
// Pure vanilla JS (no framework island): a static <script type="module"> that
// calls the API at rootmyandroid.com/v1. Same logic as the old React island.
import Base from '../layouts/Base.astro'
import DepositPanel from '../components/DepositPanel.astro'
---

<Base
  title="Account"
  description="Your Root My Android account: create an account number and add time. No email, no password."
>
  <div class="container" style="padding: 3rem 1.25rem">
    <h1 style="margin: 0 0 0.5rem">Your account</h1>
    <p class="muted">
      No email. No password. Your 16-digit account number <em>is</em> your
      account — keep it safe.
    </p>

    <div id="notice" class="notice notice-ok" hidden></div>
    <div id="error" class="notice notice-warn" hidden></div>

    <div class="panel">
      <h2>Account number</h2>
      <form id="lookup-form" class="stack">
        <input
          id="account-number"
          type="text"
          inputmode="numeric"
          autocomplete="off"
          spellcheck="false"
          placeholder="1234 5678 9012 3456"
        />
        <div class="row">
          <button type="submit" class="btn btn-primary" id="lookup-btn">Look up</button>
          <button type="button" class="btn" id="create-btn">Generate new account</button>
        </div>
      </form>
      <div id="balance" class="balance" hidden>
        <span>
          <span class="label">Balance</span><br />
          <span class="days"><span id="credit-days">0</span> <span class="muted" style="font-size:1rem">days</span></span>
        </span>
      </div>
    </div>

    <div class="panel">
      <h2>Halo</h2>
      {/* Real balance: filled in from the API after an account lookup/create. */}
      <a class="halo-bar" href="/pricing" aria-label="Halo balance — open the Pricing page">
        <span class="halo-label">Halo</span>
        <span class="halo-track"><span class="halo-fill" id="halo-fill" style="width: 0%"></span></span>
        <span class="halo-value" id="halo-value">0</span>
      </a>
      <p class="small faint" id="halo-hint">
        Halo balances convert to subscription time when plans land.
        Look up your account to see your balance. <a href="/pricing">Learn more</a>.
      </p>
    </div>

    <div class="panel">
      <h2>Buy Halo</h2>
      <div class="grid-3">
        <button class="plan" data-pack="halo_1" disabled>
          <div class="price">$5</div>
          <div class="term">1 Halo</div>
          <div class="save">base rate</div>
        </button>
        <button class="plan" data-pack="halo_4" disabled>
          <div class="price">$20</div>
          <div class="term">4 Halos</div>
          <div class="save">linear rate</div>
        </button>
        <button class="plan" data-pack="halo_6" disabled>
          <div class="price">$30</div>
          <div class="term">6 Halos</div>
          <div class="save">linear rate</div>
        </button>
      </div>
      <p class="small faint" id="plan-hint">Enter or generate an account number above to buy Halo.</p>
      <div class="row" style="margin-top: 0.75rem">
        <label class="small muted" for="pay-currency">Pay with</label>
        <select id="pay-currency">
          <option value="ltc" selected>LTC — Litecoin</option>
          <option value="btc">BTC — Bitcoin</option>
          <option value="eth">ETH — Ethereum</option>
          <option value="usdttrc20">USDT — TRC-20</option>
          <option value="usdc">USDC</option>
          <option value="xmr">XMR — Monero</option>
          <option value="sol">SOL — Solana</option>
        </select>
      </div>
      <p class="small faint">
        Pick a pack and a coin — you pay right here on this page. Your Halo is
        credited automatically once the network confirms ($5 = 1 Halo) and
        converts to subscription time when plans land. Card / Apple Pay
        support is planned via a fiat on-ramp.
      </p>
    </div>

    <DepositPanel />

    <div class="panel">
      <h2>Redeem a code</h2>
      <p class="small muted">
        Have a voucher code? Enter it here to credit its value to the account
        number above — Halo converts to subscription time when plans land.
      </p>
      <div class="row">
        <input
          id="redeem-code"
          type="text"
          autocomplete="off"
          spellcheck="false"
          placeholder="XXXX-XXXX-XXXX-XXXX"
          style="flex: 1"
        />
        <button type="button" class="btn btn-primary" id="redeem-btn" disabled>Redeem</button>
      </div>
    </div>

    <div class="panel">
      <h2>Device audit</h2>
      <p class="small muted">
        Scan any device in real time — and see which apps on an Android device
        are actually covered by backup, and which are one lost phone away from
        gone.
      </p>
      <a class="btn" href="/audit">Open Device Audit</a>
    </div>
  </div>

  <script>
    import '../scripts/analytics.ts'
    import '../scripts/account.ts'
    import '../scripts/support.ts'
  </script>
</Base>
