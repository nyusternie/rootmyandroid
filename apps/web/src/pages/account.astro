---
// src/pages/account.astro — account: account number creation, balance, redeem.
// Pure vanilla JS (no framework island): a static <script type="module"> that
// calls the API at rootmyandroid.com/v1. Same logic as the old React island.
// 2026-11-08: the Halo currency was fully discontinued (owner ruling) — the
// Buy panel and Halo balance bar were removed; plan checkout on this page
// returns with the Guru Balance work (docs/HANDOFF-2026-11-08-gurus-page.md).
import Base from '../layouts/Base.astro'
---

<Base
  title="Account"
  description="Your Root My Android account: create an account number and add time. No email, no password."
  banner
>
  <div class="container px-5 py-12">
    <h1 class="mt-0 mb-2">Your account</h1>
    <p class="muted">
      No email. No password. Your 16-digit account number <em>is</em> your
      account — keep it safe.
    </p>

    <div id="notice" class="notice notice-ok" hidden></div>
    <div id="error" class="notice notice-warn" hidden></div>

    <div class="panel">
      <h2>Account number</h2>
      <form id="lookup-form" class="stack">
        <input
          id="account-number"
          type="text"
          inputmode="numeric"
          autocomplete="off"
          spellcheck="false"
          placeholder="1234 5678 9012 3456"
        />
        <div class="row">
          <button type="submit" class="btn btn-primary" id="lookup-btn">Look up</button>
          <button type="button" class="btn" id="create-btn">Generate new account</button>
        </div>
      </form>
      <div id="balance" class="balance" hidden>
        <span>
          <span class="label">Balance</span><br />
          <span class="days"><span id="credit-days">0</span> <span class="muted text-[1rem]">days</span></span>
        </span>
      </div>
    </div>

    <div class="panel">
      <h2>Add time</h2>
      <p class="small muted">
        Guardian Angel and Rootz Pro are top-up subscriptions: add time
        whenever you like — no auto-renew, no stored card. See
        {' '}<a href="/pricing">Pricing</a> for the current lineup. Checkout on
        this page returns soon.
      </p>
    </div>

    <div class="panel">
      <h2>Redeem a code</h2>
      <p class="small muted">
        Have a voucher code? Enter it here to credit its plan time to the account
        number above.
      </p>
      <div class="row">
        <input
          id="redeem-code"
          type="text"
          autocomplete="off"
          spellcheck="false"
          placeholder="XXXX-XXXX-XXXX-XXXX"
          class="flex-1"
        />
        <button type="button" class="btn btn-primary" id="redeem-btn" disabled>Redeem</button>
      </div>
    </div>

    <div class="panel">
      <h2>Device audit</h2>
      <p class="small muted">
        Scan any device in real time — and see which apps on an Android device
        are actually covered by backup, and which are one lost phone away from
        gone.
      </p>
      <a class="btn" href="/audit">Open Device Audit</a>
    </div>
  </div>

  <script>
    import '../scripts/analytics.ts'
    import '../scripts/account.ts'
    import '../scripts/support.ts'
  </script>
</Base>
