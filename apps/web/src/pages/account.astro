---
// src/pages/account.astro — account: account number creation + buy Nitro.
// Pure vanilla JS (no framework island): a static <script type="module"> that
// calls the API at rootmyandroid.com/v1. Same logic as the old React island.
import Base from '../layouts/Base.astro'
---

<Base
  title="Account"
  description="Your Root My Android account: create an account number and add time. No email, no password."
>
  <div class="container" style="padding: 3rem 1.25rem">
    <h1 style="margin: 0 0 0.5rem">Your account</h1>
    <p class="muted">
      No email. No password. Your 16-digit account number <em>is</em> your
      account — keep it safe.
    </p>

    <div id="notice" class="notice notice-ok" hidden></div>
    <div id="error" class="notice notice-warn" hidden></div>

    <div class="panel">
      <h2>Account number</h2>
      <form id="lookup-form" class="stack">
        <input
          id="account-number"
          type="text"
          inputmode="numeric"
          autocomplete="off"
          spellcheck="false"
          placeholder="1234 5678 9012 3456"
        />
        <div class="row">
          <button type="submit" class="btn btn-primary" id="lookup-btn">Look up</button>
          <button type="button" class="btn" id="create-btn">Generate new account</button>
        </div>
      </form>
      <div id="balance" class="balance" hidden>
        <span>
          <span class="label">Balance</span><br />
          <span class="days"><span id="credit-days">0</span> <span class="muted" style="font-size:1rem">days</span></span>
        </span>
      </div>
    </div>

    <div class="panel">
      <h2>Nitro</h2>
      {/* Real balance: filled in from the API after an account lookup/create. */}
      <a class="nitro-bar" href="/nitro" aria-label="Nitro balance — open the Nitro page">
        <span class="nitro-label">Nitro</span>
        <span class="nitro-track"><span class="nitro-fill" id="nitro-fill" style="width: 0%"></span></span>
        <span class="nitro-value" id="nitro-value">0</span>
      </a>
      <p class="small faint" id="nitro-hint">
        Nitro is the energy your account burns to keep PRO features running.
        Look up your account to see your balance. <a href="/nitro">Learn more</a>.
      </p>
    </div>

    <div class="panel">
      <h2>Buy Nitro</h2>
      <div class="grid-3">
        <button class="plan" data-pack="nitro_100" disabled>
          <div class="price">$5</div>
          <div class="term">100 Nitro</div>
          <div class="save">base rate</div>
        </button>
        <button class="plan" data-pack="nitro_500" disabled>
          <div class="price">$20</div>
          <div class="term">500 Nitro</div>
          <div class="save">20% off</div>
        </button>
        <button class="plan" data-pack="nitro_1000" disabled>
          <div class="price">$30</div>
          <div class="term">1,000 Nitro</div>
          <div class="save">40% off</div>
        </button>
      </div>
      <p class="small faint" id="plan-hint">Enter or generate an account number above to buy Nitro.</p>
      <div class="row" style="margin-top: 0.75rem">
        <label class="small muted"><input type="radio" name="rail" value="card" checked /> Card</label>
        <label class="small muted"><input type="radio" name="rail" value="crypto" /> Crypto (BTC / Lightning)</label>
      </div>
      <p class="small faint">
        Card payments are handled by our payment partner and converted to crypto
        automatically. You're redirected to a secure hosted checkout to finish.
      </p>
    </div>

    <div class="panel">
      <h2>Device audit</h2>
      <p class="small muted">
        Scan any device in real time — and see which apps on an Android device
        are actually covered by backup, and which are one lost phone away from
        gone.
      </p>
      <a class="btn" href="/audit">Open Device Audit</a>
    </div>
  </div>

  <script>
    import '../scripts/account.ts'
  </script>
</Base>
