---
// src/pages/guardian.astro — /guardian: the Guardian Angel control page.
// Rootz has /terminal; Guardian Angel gets its own device registry: enter
// the 16-digit account number, pick a paired device, see what it is.
// On-device settings (device protection, launcher icon) stay in the app —
// this page is the account's view of its managed devices.
// Vanilla TS (src/scripts/guardian.ts), same pattern as terminal.astro.
import Base from '../layouts/Base.astro'
---

<Base
  title="Guardian Angel"
  description="The devices paired to your Root My Android account — Guardian Angel parental controls. Pick a device to see it."
  banner
>
  <div class="container px-5 py-12">
    <h1 class="mt-0 mb-2">Guardian Angel</h1>
    <p class="muted">
      The devices on your account, in one place. Enter your 16-digit account
      number and pick a device — on-device settings stay in the
      <a href="/guardian-angel">Guardian Angel app</a>, which is the only
      thing that can protect a phone.
    </p>

    <div class="panel">
      <h2>Account</h2>
      <p class="break-words text-body text-[1.15rem]">
        Enter the 16-digit account number the Guardian Angel app synced with —
        the devices load automatically. One account holds every managed phone,
        up to five.
      </p>
      <div class="stack">
        <input
          id="account-number"
          class="text-[1.2rem]"
          type="text"
          inputmode="numeric"
          autocomplete="off"
          spellcheck="false"
          placeholder="1234 5678 9012 3456"
        />
        <div class="row">
          <select id="device-select" class="min-w-0 flex-1 text-[1.2rem]" aria-label="Device">
            <option value="">Devices load once your account number is complete…</option>
          </select>
          <button type="button" class="btn" id="load-devices-btn">Refresh list</button>
        </div>
      </div>
      <p id="conn-status" class="text-body text-[1.15rem]">Not loaded.</p>
    </div>

    <div class="panel">
      <h2>Device</h2>
      <dl class="row flex-wrap gap-x-8">
        <div>
          <dt class="text-body text-[1rem]">name</dt>
          <dd class="m-0" id="devinfo-name">—</dd>
        </div>
        <div>
          <dt class="text-body text-[1rem]">paired</dt>
          <dd class="m-0" id="devinfo-paired">—</dd>
        </div>
        <div>
          <dt class="text-body text-[1rem]">device_id</dt>
          <dd class="m-0 break-all" id="devinfo-id">—</dd>
        </div>
      </dl>
      <p class="mt-3 text-body text-[1rem]">
        The device id is what the app stores after its first sync. It is not a
        secret on its own — the account number is the credential.
      </p>
    </div>

    <div class="panel">
      <h2>Set up a device</h2>
      <ol class="text-body text-[1.05rem]">
        <li class="mb-2">
          <strong class="text-ink">Install Guardian Angel</strong> on the phone
          you want to protect — the
          <a href="/downloads">downloads page</a> has the APK.
        </li>
        <li class="mb-2">
          <strong class="text-ink">Open it and sync.</strong> Type your
          16-digit account number and press <em>Sync with Root My Android</em>.
          The phone appears here within a few seconds.
        </li>
        <li class="mb-2">
          <strong class="text-ink">Turn on protection in the app.</strong>
          Device administrator access is what stops the app from being
          uninstalled; the launcher icon can be hidden once the phone is
          synced.
        </li>
      </ol>
      <p class="text-body text-[1rem]">
        Up to five devices per account. Everything that touches the phone —
        protection, icon visibility, uninstalling — happens on the phone, never
        from this page.
      </p>
    </div>
  </div>

  <script>
    import '../scripts/analytics.ts'
    import '../scripts/guardian.ts'
    import '../scripts/support.ts'
  </script>
</Base>
