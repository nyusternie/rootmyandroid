---
// src/layouts/Device.astro — shared shell for the /device/<codename>
// catalog pages (generated from src/content/devices/*.md by
// src/pages/device/[...id].astro). Layers on Base.astro and renders ALL
// page prose — the generated collection files carry frontmatter only, so
// every wording change is a single-point edit here. All prose is original
// (owner ruling 2026-11-08: facts imported, prose 100% ours, no source
// attribution on the page).
//
// RENDERING BRANCHES (2026-11-08 expansion):
//   - supportstatus 'Current' (TWRP-imported): custom-recovery download
//     buttons (single folder) or a labeled per-SKU variants table.
//   - anything else (Google-imported Pixels: 'No official TWRP build
//     listed', displayed as 'none listed' via deviceStatusLabel): honest
//     no-recovery sections — root options (Magisk facts per our /Magisk
//     profile and the official Magisk docs) and, when `factoryimages` is
//     set, a factory-images section.
//   - `notes` renders as a caution callout near the top (e.g. Google's
//     anti-rollback warnings).
//   - OG art: a per-device card (public/img/devices/<slug>.png) when one
//     exists, else the Pixel catalog card for Google-branded pages, else
//     the general device catalog card.
// Owner ruling 2026-11-08: /device is a GENERAL devices catalog, NOT a
// TWRP page — NO TWRP references anywhere in this template (download URLs
// themselves stay: they are the factual locations of the official builds).
// These are CONTENT pages: zero JavaScript (AGENTS.md rule 4). Structured
// data mirrors visible copy: the TechArticle dateModified matches the
// visible "Listed" line, the BreadcrumbList matches the "← All devices"
// link.
import type { CollectionEntry } from 'astro:content'
import { existsSync } from 'node:fs'
import { join } from 'node:path'
import Base from './Base.astro'
import { deviceStatusLabel } from '../lib/devices.js'

interface Props {
  device: CollectionEntry<'devices'>
}

const { device } = Astro.props
const d = device.data

const updatedIso = d.updated.toISOString().slice(0, 10)
const isTwrpCurrent = d.supportstatus.toLowerCase() === 'current'
// Recovery-agnostic display label for the support status (see devices.js).
const statusLabel = deviceStatusLabel(d.supportstatus)
const title = d.title
const description = isTwrpCurrent
  ? `${d.title} (codename ${d.codename}): device facts, custom-recovery support status, ` +
    `downloads, and a free pre-flash device check.`
  : `${d.title} (codename ${d.codename}): device facts, root options, factory images, ` +
    `and a free device check.`
const canonical = new URL(`/device/${device.id}/`, Astro.site).href
const markdownUrl = `/device/${device.id}.md`

// Catalog OG art (see public/img/devices/): a per-device card when one has
// been generated for this device, else the Pixel card for Google-branded
// pages, else the general device card.
const perDeviceArt = `/img/devices/${device.id}.png`
// process.cwd() is apps/web during astro build (import.meta.url does NOT
// resolve to the source file there — verified 2026-11-08).
const ogImage = existsSync(join(process.cwd(), 'public', 'img', 'devices', `${device.id}.png`))
  ? perDeviceArt
  : d.oem.toLowerCase() === 'google'
    ? '/img/devices/og-device-google.png'
    : '/img/devices/og-device.png'
const ogImageAlt = isTwrpCurrent
  ? `${d.title} — device facts and downloads`
  : `${d.title} — root options and device facts`

// TechArticle JSON-LD — mirrors the visible headline, description, and
// "Listed" date (structured data mirrors copy — AGENTS.md).
const org = { '@type': 'Organization', name: 'Root My Android', url: Astro.site }
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  description,
  mainEntityOfPage: canonical,
  author: org,
  publisher: org,
  dateModified: updatedIso,
}
// Mirrors the visible "← All devices" breadcrumb link rendered below.
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Devices', item: new URL('/devices/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: d.title, item: canonical },
  ],
}

// Related reading (SEO + navigation) — the recovery/root topics most
// relevant to someone holding this device.
const related = [
  { href: '/Magisk', label: 'Magisk' },
  { href: '/KernelSU', label: 'KernelSU' },
  { href: '/APatch', label: 'APatch' },
  { href: '/LineageOS', label: 'LineageOS' },
]
---

<Base
  title={title}
  description={description}
  ogType="article"
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
>
  <link slot="head" rel="alternate" type="text/markdown" href={markdownUrl} />

  <article class="container px-5 py-12">
    <p><a href="/devices">← All devices</a></p>

    {/* Header row (owner ruling 2026-11-08): title block left, page art
        right — TOP-ALIGNED with the title at half the content width on
        large screens; art full-width below the text on tablets/phones.
        Breakpoint: Tailwind min-[1025px]: utilities (styling is 100%
        Tailwind — see the global.css doctrine). */}
    <div class="mb-7 flex flex-col gap-5 min-[1025px]:flex-row min-[1025px]:items-start min-[1025px]:gap-6">
      <div class="min-w-0 min-[1025px]:flex-1">
        <h1 class="mt-0 mb-3">{title}</h1>
        <p class="muted mb-2 text-[1.1rem] max-w-[44rem]">
          {d.oem} · codename <code>{d.codename}</code> · recovery support:{' '}
          <strong>{statusLabel}</strong>
          {d.maintainer.length > 0 && <> · maintained by {d.maintainer.join(', ')}</>}
        </p>

        <p class="faint small m-0">
          Listed <time datetime={updatedIso}>{updatedIso}</time>
          {' · '}
          <a href={markdownUrl} rel="alternate" type="text/markdown">View as Markdown</a>
        </p>
      </div>

      {/* Visible page art: the same resolved card used for og:image — a
          per-device render when one exists, else the catalog card. The page
          previously carried the art ONLY in the (invisible) og:image meta,
          which read as "no graphics at all" on the page (owner 2026-11-08). */}
      <img
        class="m-0 block h-auto w-full rounded-xl min-[1025px]:w-1/2 min-[1025px]:basis-1/2"
        src={ogImage}
        alt={ogImageAlt}
        width="1200"
        height="630"
        loading="eager"
        decoding="async"
      />
    </div>

    {
      d.notes && (
        <aside
          class="panel"
          class="mb-8 max-w-[44rem] border-l-[3px] border-l-accent"
        >
          <h2 class="mt-0">Flashing caution</h2>
          <p class="muted m-0">{d.notes}</p>
        </aside>
      )
    }

    <section class="panel mb-8">
      <h2 class="mt-0">Device facts</h2>
      <dl
        class="m-0 grid grid-cols-[max-content_1fr] gap-x-4 gap-y-[0.35rem]"
      >
        <dt class="muted">Device</dt>
        <dd class="m-0">{d.title}</dd>
        <dt class="muted">Brand</dt>
        <dd class="m-0">{d.oem}</dd>
        <dt class="muted">Codename</dt>
        <dd class="m-0"><code>{d.codename}</code></dd>
        <dt class="muted">Recovery support</dt>
        <dd class="m-0">{statusLabel}</dd>
        {
          d.maintainer.length > 0 && (
            <>
              <dt class="muted">Recovery maintainer</dt>
              <dd class="m-0">{d.maintainer.join(', ')}</dd>
            </>
          )
        }
        {
          d.devicetree && (
            <>
              <dt class="muted">Device tree</dt>
              <dd class="m-0">
                <a href={d.devicetree} rel="noopener">source repository</a>
              </dd>
            </>
          )
        }
        {
          d.factoryimages && (
            <>
              <dt class="muted">Factory images</dt>
              <dd class="m-0">
                <a href={d.factoryimages} rel="noopener">{d.factoryimages}</a>
              </dd>
            </>
          )
        }
      </dl>
    </section>

    {
      d.downloadfolder && (
        <section class="mb-8">
          <h2>Custom recovery downloads</h2>
          <p class="muted">
            Official builds are published per device. Builds are device-specific —
            only a build made for the {d.title} is safe to use.
          </p>
          <div class="row">
            <a
              class="btn btn-primary"
              href={`https://dl.twrp.me/${d.downloadfolder}/`}
              rel="noopener"
            >
              Americas mirror
            </a>
            <a class="btn" href={`https://eu.dl.twrp.me/${d.downloadfolder}/`} rel="noopener">
              Europe mirror
            </a>
          </div>
        </section>
      )
    }

    {
      !d.downloadfolder && d.variants && d.variants.length > 0 && (
        <section class="mb-8">
          <h2>Custom recovery downloads</h2>
          <p class="muted max-w-[44rem]">
            This device has separate official builds per variant — pick the one that
            matches your exact model or SKU. Only a build made for the {d.title}
            variant you own is safe to use.
          </p>
          <table
            class="w-full max-w-[44rem] border-collapse text-[0.95rem]"
          >
            <thead>
              <tr class="text-left">
                <th class="py-[0.4rem] pr-3 pl-0">Variant</th>
                <th class="py-[0.4rem] pr-3 pl-0">Folder</th>
                <th class="py-[0.4rem] pr-3 pl-0">Americas</th>
                <th class="py-[0.4rem] px-0">Europe</th>
              </tr>
            </thead>
            <tbody>
              {d.variants.map((variant) => (
                <tr class="border-t border-line">
                  <td class="py-2 pr-3 pl-0">{variant.label}</td>
                  <td class="py-2 pr-3 pl-0">
                    <code>{variant.folder}</code>
                  </td>
                  <td class="py-2 pr-3 pl-0">
                    <a href={`https://dl.twrp.me/${variant.folder}/`} rel="noopener">
                      Download
                    </a>
                  </td>
                  <td class="py-2 px-0">
                    <a href={`https://eu.dl.twrp.me/${variant.folder}/`} rel="noopener">
                      Download
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      )
    }

    {
      !isTwrpCurrent && (
        <section class="mb-8">
          <h2>Rooting the {d.title}</h2>
          <p class="muted max-w-[44rem]">
            No custom recovery build is listed for the {d.title}. That does not
            rule out root: the standard route on modern phones is Magisk — systemless
            root that patches the boot image instead of modifying the system
            partition. Magisk requires an unlocked bootloader, and rooting trips the
            integrity checks that banking and payment apps actively look for, so
            weigh that before you start.
          </p>
          <p class="muted max-w-[44rem]">
            The Magisk app can patch a factory-image package directly
            {d.factoryimages && (
              <>
                , and on Pixel devices it can even fetch the latest factory image
                from Google's servers for you
              </>
            )}
            . Read our <a href="/Magisk">Magisk profile</a> and stick to the
            official Magisk documentation for the exact steps.
          </p>
        </section>
      )
    }

    {
      d.factoryimages && (
        <section class="mb-8">
          <h2>Factory images</h2>
          <p class="muted max-w-[44rem]">
            Google publishes stock factory images for Pixel devices — the firmware
            you flash to restore the device to its original factory state — on its
            developer site.
          </p>
          <div class="row">
            <a class="btn btn-primary" href={d.factoryimages} rel="noopener">
              Google factory images
            </a>
          </div>
        </section>
      )
    }

    <section class="mb-8">
      <h2>{isTwrpCurrent ? 'Before you flash' : 'Before you root'}</h2>
      {
        isTwrpCurrent ? (
          <p class="muted max-w-[44rem]">
            A custom recovery replaces the stock recovery environment: it can flash
            ZIP packages, take and restore full partition backups (Nandroid), and
            manage partitions. Installing a custom recovery generally requires an
            unlocked bootloader, and unlocking factory-resets most phones.
          </p>
        ) : (
          <p class="muted max-w-[44rem]">
            Rooting starts with facts, not files: your exact model, your bootloader
            state, and whether an official build of anything exists for it.
            Guessing wrong is how phones get bricked.
          </p>
        )
      }
      <p class="muted max-w-[44rem]">
        Two free reads on this site:{' '}
        <a href="/guides/check-bootloader-status">Check your bootloader status</a> and{' '}
        <a href="/guides/what-is-rooting">What rooting actually does (and doesn't)</a>.
      </p>
      <p class="muted max-w-[44rem]">
        Our free <a href="/scan">browser-based scan</a> identifies your exact device
        model and bootloader state over USB — the facts that decide what unlocking
        involves and which build you need.
      </p>
      <p>
        <a class="btn btn-primary" href="/scan">Scan your device now — free</a>
      </p>
    </section>

    <nav class="panel mb-6" aria-label="Related topics">
      <h2 class="mt-0">Related topics</h2>
      <div class="row">
        {related.map((p) => <a href={p.href}>{p.label}</a>)}
      </div>
    </nav>

    <p class="faint small max-w-[44rem]">
      Root My Android is an independent site and is not affiliated with, endorsed by,
      or sponsored by any device maker or software project. Recovery support
      statuses and downloads refer to the best-known open-source custom recovery
      for Android. Android is a trademark of Google LLC. Flashing any third-party
      software is at your own risk; make sure every build matches your exact
      device before you install it.
    </p>

    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </article>

</Base>
