---
// src/layouts/Device.astro — shared shell for the /device/<codename>
// catalog pages (generated from src/content/devices/*.md by
// src/pages/device/[...id].astro). Layers on Base.astro and renders ALL
// page prose — the generated collection files carry frontmatter only, so
// every wording change is a single-point edit here. All prose is original
// (owner ruling 2026-11-08: facts imported, prose 100% ours, no source
// attribution on the page).
//
// RENDERING BRANCHES (2026-11-08 expansion):
//   - supportstatus 'Current' (TWRP-imported): title "TWRP for …",
//     download buttons (single folder) or a labeled per-SKU variants table.
//   - anything else (Google-imported Pixels: 'No official TWRP build
//     listed'): honest no-TWRP sections — root options (Magisk facts per
//     our /Magisk profile and the official Magisk docs) and, when
//     `factoryimages` is set, a factory-images section.
//   - `notes` renders as a caution callout near the top (e.g. Google's
//     anti-rollback warnings).
//   - OG art: Google-branded pages get the Pixel catalog card, all other
//     pages the general device catalog card (public/img/devices/).
// These are CONTENT pages: zero JavaScript (AGENTS.md rule 4). Structured
// data mirrors visible copy: the TechArticle dateModified matches the
// visible "Listed" line, the BreadcrumbList matches the "← All devices"
// link.
import type { CollectionEntry } from 'astro:content'
import Base from './Base.astro'

interface Props {
  device: CollectionEntry<'devices'>
}

const { device } = Astro.props
const d = device.data

const updatedIso = d.updated.toISOString().slice(0, 10)
const isTwrpCurrent = d.supportstatus.toLowerCase() === 'current'
const title = isTwrpCurrent
  ? `TWRP for ${d.title}`
  : `${d.title}: rooting & device facts`
const description = isTwrpCurrent
  ? `TWRP for the ${d.title} (codename ${d.codename}): official support status, ` +
    `maintainer, downloads, and a free pre-flash device check.`
  : `${d.title} (codename ${d.codename}): no official TWRP build is listed — root options, ` +
    `factory images, device facts, and a free device check.`
const canonical = new URL(`/device/${device.id}/`, Astro.site).href
const markdownUrl = `/device/${device.id}.md`

// Catalog OG art (see public/img/devices/): Pixel card for Google-branded
// pages, general device card for everything else.
const ogImage =
  d.oem.toLowerCase() === 'google' ? '/img/devices/og-device-google.png' : '/img/devices/og-device.png'
const ogImageAlt = isTwrpCurrent
  ? `TWRP for the ${d.title} — device facts and downloads`
  : `${d.title} — root options and device facts`

// TechArticle JSON-LD — mirrors the visible headline, description, and
// "Listed" date (structured data mirrors copy — AGENTS.md).
const org = { '@type': 'Organization', name: 'Root My Android', url: Astro.site }
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  description,
  mainEntityOfPage: canonical,
  author: org,
  publisher: org,
  dateModified: updatedIso,
}
// Mirrors the visible "← All devices" breadcrumb link rendered below.
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Devices', item: new URL('/device/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: d.title, item: canonical },
  ],
}

// Related reading (SEO + navigation) — the recovery/root topics most
// relevant to someone holding this device.
const related = [
  { href: '/TWRP', label: 'TWRP' },
  { href: '/Magisk', label: 'Magisk' },
  { href: '/KernelSU', label: 'KernelSU' },
  { href: '/APatch', label: 'APatch' },
  { href: '/LineageOS', label: 'LineageOS' },
]
---

<Base
  title={title}
  description={description}
  ogType="article"
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
>
  <link slot="head" rel="alternate" type="text/markdown" href={markdownUrl} />

  <article class="container" style="padding: 3rem 1.25rem">
    <p><a href="/device">← All devices</a></p>

    <h1 style="margin: 0 0 0.75rem">{title}</h1>
    <p class="muted" style="margin: 0 0 0.5rem; font-size: 1.1rem; max-width: 44rem">
      {d.oem} · codename <code>{d.codename}</code> · official support status:{' '}
      <strong>{d.supportstatus}</strong>
      {d.maintainer.length > 0 && <> · maintained by {d.maintainer.join(', ')}</>}
    </p>
    <p class="faint small" style="margin: 0 0 1.75rem">
      Listed <time datetime={updatedIso}>{updatedIso}</time>
      {' · '}
      <a href={markdownUrl} rel="alternate" type="text/markdown">View as Markdown</a>
    </p>

    {
      d.notes && (
        <aside
          class="panel"
          style="margin: 0 0 2rem; border-left: 3px solid var(--color-accent); max-width: 44rem"
        >
          <h2 style="margin-top: 0">Flashing caution</h2>
          <p class="muted" style="margin: 0">{d.notes}</p>
        </aside>
      )
    }

    <section class="panel" style="margin: 0 0 2rem">
      <h2 style="margin-top: 0">Device facts</h2>
      <dl
        style="display: grid; grid-template-columns: max-content 1fr; gap: 0.35rem 1rem; margin: 0"
      >
        <dt class="muted">Device</dt>
        <dd style="margin: 0">{d.title}</dd>
        <dt class="muted">Brand</dt>
        <dd style="margin: 0">{d.oem}</dd>
        <dt class="muted">Codename</dt>
        <dd style="margin: 0"><code>{d.codename}</code></dd>
        <dt class="muted">Support status</dt>
        <dd style="margin: 0">{d.supportstatus}</dd>
        {
          d.maintainer.length > 0 && (
            <>
              <dt class="muted">Maintainer</dt>
              <dd style="margin: 0">{d.maintainer.join(', ')}</dd>
            </>
          )
        }
        {
          d.devicetree && (
            <>
              <dt class="muted">Device tree</dt>
              <dd style="margin: 0">
                <a href={d.devicetree} rel="noopener">{d.devicetree}</a>
              </dd>
            </>
          )
        }
        {
          d.factoryimages && (
            <>
              <dt class="muted">Factory images</dt>
              <dd style="margin: 0">
                <a href={d.factoryimages} rel="noopener">{d.factoryimages}</a>
              </dd>
            </>
          )
        }
      </dl>
    </section>

    {
      d.downloadfolder && (
        <section style="margin: 0 0 2rem">
          <h2>Download TWRP</h2>
          <p class="muted">
            Official builds are published per device on the TWRP mirrors. Builds are
            device-specific — only a build made for the {d.title} is safe to use.
          </p>
          <div class="row">
            <a
              class="btn btn-primary"
              href={`https://dl.twrp.me/${d.downloadfolder}/`}
              rel="noopener"
            >
              Americas mirror
            </a>
            <a class="btn" href={`https://eu.dl.twrp.me/${d.downloadfolder}/`} rel="noopener">
              Europe mirror
            </a>
          </div>
        </section>
      )
    }

    {
      !d.downloadfolder && d.variants && d.variants.length > 0 && (
        <section style="margin: 0 0 2rem">
          <h2>Download TWRP</h2>
          <p class="muted" style="max-width: 44rem">
            This device has separate official builds per variant — pick the one that
            matches your exact model or SKU. Builds are published on the TWRP
            mirrors; only a build made for the {d.title} variant you own is safe to
            use.
          </p>
          <table
            style="width: 100%; max-width: 44rem; border-collapse: collapse; font-size: 0.95rem"
          >
            <thead>
              <tr style="text-align: left">
                <th style="padding: 0.4rem 0.75rem 0.4rem 0">Variant</th>
                <th style="padding: 0.4rem 0.75rem 0.4rem 0">Folder</th>
                <th style="padding: 0.4rem 0.75rem 0.4rem 0">Americas</th>
                <th style="padding: 0.4rem 0">Europe</th>
              </tr>
            </thead>
            <tbody>
              {d.variants.map((variant) => (
                <tr style="border-top: 1px solid var(--color-line)">
                  <td style="padding: 0.5rem 0.75rem 0.5rem 0">{variant.label}</td>
                  <td style="padding: 0.5rem 0.75rem 0.5rem 0">
                    <code>{variant.folder}</code>
                  </td>
                  <td style="padding: 0.5rem 0.75rem 0.5rem 0">
                    <a href={`https://dl.twrp.me/${variant.folder}/`} rel="noopener">
                      dl.twrp.me
                    </a>
                  </td>
                  <td style="padding: 0.5rem 0">
                    <a href={`https://eu.dl.twrp.me/${variant.folder}/`} rel="noopener">
                      eu.dl.twrp.me
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      )
    }

    {
      !isTwrpCurrent && (
        <section style="margin: 0 0 2rem">
          <h2>Rooting the {d.title}</h2>
          <p class="muted" style="max-width: 44rem">
            No official TWRP build is listed for the {d.title}. That does not rule
            out root: the standard route on modern phones is Magisk — systemless
            root that patches the boot image instead of modifying the system
            partition. Magisk requires an unlocked bootloader, and rooting trips the
            integrity checks that banking and payment apps actively look for, so
            weigh that before you start.
          </p>
          <p class="muted" style="max-width: 44rem">
            The Magisk app can patch a factory-image package directly
            {d.factoryimages && (
              <>
                , and on Pixel devices it can even fetch the latest factory image
                from Google's servers for you
              </>
            )}
            . Read our <a href="/Magisk">Magisk profile</a> and stick to the
            official Magisk documentation for the exact steps.
          </p>
        </section>
      )
    }

    {
      d.factoryimages && (
        <section style="margin: 0 0 2rem">
          <h2>Factory images</h2>
          <p class="muted" style="max-width: 44rem">
            Google publishes stock factory images for Pixel devices — the firmware
            you flash to restore the device to its original factory state — on its
            developer site.
          </p>
          <div class="row">
            <a class="btn btn-primary" href={d.factoryimages} rel="noopener">
              Google factory images
            </a>
          </div>
        </section>
      )
    }

    <section style="margin: 0 0 2rem">
      <h2>{isTwrpCurrent ? 'Before you flash' : 'Before you root'}</h2>
      {
        isTwrpCurrent ? (
          <p class="muted" style="max-width: 44rem">
            TWRP is an open-source custom recovery: it can flash ZIP packages, take
            and restore full partition backups (Nandroid), and manage partitions.
            Installing a custom recovery generally requires an unlocked bootloader,
            and unlocking factory-resets most phones.
          </p>
        ) : (
          <p class="muted" style="max-width: 44rem">
            Rooting starts with facts, not files: your exact model, your bootloader
            state, and whether an official build of anything exists for it.
            Guessing wrong is how phones get bricked.
          </p>
        )
      }
      <p class="muted" style="max-width: 44rem">
        Two free reads on this site:{' '}
        <a href="/guides/check-bootloader-status">Check your bootloader status</a> and{' '}
        <a href="/guides/what-is-rooting">What rooting actually does (and doesn't)</a>.
      </p>
      <p class="muted" style="max-width: 44rem">
        Our free <a href="/scan">browser-based scan</a> identifies your exact device
        model and bootloader state over USB — the facts that decide what unlocking
        involves and which build you need.
      </p>
      <p>
        <a class="btn btn-primary" href="/scan">Scan your device now — free</a>
      </p>
    </section>

    <nav class="panel" aria-label="Related topics" style="margin: 0 0 1.5rem">
      <h2 style="margin-top: 0">Related topics</h2>
      <div class="row">
        {related.map((p) => <a href={p.href}>{p.label}</a>)}
      </div>
    </nav>

    <p class="faint small" style="max-width: 44rem">
      Root My Android is an independent site and is not affiliated with, endorsed by,
      or sponsored by Team Win (TWRP). Android is a trademark of Google LLC.
      Flashing any third-party software is at your own risk; make sure every build
      matches your exact device before you install it.
    </p>

    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </article>
</Base>
