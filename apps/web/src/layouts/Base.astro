---
// src/layouts/Base.astro — shared shell: header, footer, SEO meta.
// Analytics: no-JS browsers are counted by the first-party pixel at the
// bottom of <body> (no scripts on content pages — see AGENTS.md rule 4).
import '../styles/global.css'

interface Props {
  title: string
  description?: string
}

const {
  title,
  description = 'Root My Android — scan your Android device and get a rooting / upgrade plan. No email, no password. $5/month.',
} = Astro.props

const pageTitle = title === 'Root My Android' ? title : `${title} — Root My Android`
const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL('/og-image.png', Astro.site)
const year = new Date().getFullYear()

// Sitewide structured data (JSON-LD). Page-specific schema (e.g.
// SoftwareApplication on the landing page) lives in the page itself.
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Root My Android',
  url: Astro.site,
  logo: new URL('/apple-touch-icon.png', Astro.site).href,
}
const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Root My Android',
  url: Astro.site,
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Root My Android" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Root My Android — device-matched rooting plans" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0d0f12" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="/">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 2 4 6v6c0 5 3.4 8.4 8 10 4.6-1.6 8-5 8-10V6l-8-4z" stroke="#3d9df2" stroke-width="2" stroke-linejoin="round" fill="rgba(61,157,242,0.12)"/>
            <path d="M8.5 12l2.5 2.5 4.5-5" stroke="#3d9df2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Root My Android
        </a>
        <nav class="nav">
          <a href="/guides">Guides</a>
          <a href="/roms">ROMs</a>
          <a href="/account">Account</a>
          <a class="btn btn-primary btn-sm" href="/account">Get Account</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <span>© {year} Root My Android</span>
        <span class="row">
          <a href="/guides">Guides</a>
          <a href="/roms">ROMs</a>
          <a href="/account">Account</a>
          <a href="https://rootmyandroid.com/v1/health" rel="noopener">API</a>
        </span>
        <span class="row">
          <a href="/terms">Terms</a>
          <a href="/privacy">Privacy</a>
          <a href="/refunds">Refunds</a>
          <a href="mailto:support@rootmyandroid.com">support@rootmyandroid.com</a>
        </span>
      </div>
    </footer>

    {/* First-party analytics pixel for visitors with JavaScript disabled.
        Same-origin, no cookies — see src/scripts/analytics.ts (app pages)
        and /privacy. */}
    <noscript>
      <img
        src={`/v1/analytics/t.gif?path=${encodeURIComponent(Astro.url.pathname)}`}
        width="1"
        height="1"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </noscript>
  </body>
</html>
