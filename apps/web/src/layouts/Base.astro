---
// src/layouts/Base.astro — shared shell: header, footer, SEO meta.
// Analytics: no-JS browsers are counted by the first-party pixel at the
// bottom of <body> (no scripts on content pages — see AGENTS.md rule 4).
import '../styles/global.css'

interface Props {
  title: string
  description?: string
}

const {
  title,
  description = 'Root My Android — scan your Android device and get a rooting / upgrade plan. No email, no password. Top up with Halo.',
} = Astro.props

const pageTitle = title === 'Root My Android' ? title : `${title} — Root My Android`
const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL('/og-image.png', Astro.site)
const year = new Date().getFullYear()

// Sitewide structured data (JSON-LD). Page-specific schema (e.g.
// SoftwareApplication on the landing page) lives in the page itself.
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Root My Android',
  url: Astro.site,
  logo: new URL('/apple-touch-icon.png', Astro.site).href,
}
const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Root My Android',
  url: Astro.site,
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Root My Android" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Root My Android — device unlocking assistant and Guardian Angel parental controls" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0d0f12" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="/">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9.1 6.2 7.7 4.1M14.9 6.2l1.4-2.1" stroke="#3d9df2" stroke-width="1.1" stroke-linecap="round"/>
            <path d="M6.5 11a5.5 5.5 0 0 1 11 0z" fill="#3d9df2"/>
            <circle cx="9.7" cy="8.6" r="0.85" fill="#0d0f12"/>
            <circle cx="14.3" cy="8.6" r="0.85" fill="#0d0f12"/>
            <rect x="6.5" y="12.4" width="11" height="5.4" rx="1.6" fill="#3d9df2"/>
            <rect x="4.4" y="12.4" width="1.7" height="4.6" rx="0.85" fill="#3d9df2"/>
            <rect x="17.9" y="12.4" width="1.7" height="4.6" rx="0.85" fill="#3d9df2"/>
            <g stroke="#3fb96b" stroke-linecap="round" fill="none">
              <path d="M9.2 17.4c-0.7 1.5-1.5 2.4-1.9 4.4" stroke-width="1.2"/>
              <path d="M8.1 19.9c0.5 0.8 0.9 1.3 1.2 2" stroke-width="0.75"/>
              <path d="M11.9 17.5c0.4 1.4-0.2 2.6-0.5 5.2" stroke-width="1.3"/>
              <path d="M11.9 20.3c0.6 0.6 1.2 1.1 1.6 1.9" stroke-width="0.8"/>
              <path d="M14.8 17.4c0.8 1.4 1.6 2.3 2 4.2" stroke-width="1.2"/>
              <path d="M15.9 19.7c-0.3 0.9-0.6 1.5-0.7 2.4" stroke-width="0.75"/>
            </g>
          </svg>
          Root My Android
        </a>
        <nav class="nav">
          <a href="/guides">Guides</a>
          <a href="/roms">ROMs</a>
          <a href="/account">Account</a>
          <a class="btn btn-primary btn-sm" href="/scan">Scan NOW!</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <a class="brand" href="/">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9.1 6.2 7.7 4.1M14.9 6.2l1.4-2.1" stroke="#3d9df2" stroke-width="1.1" stroke-linecap="round"/>
              <path d="M6.5 11a5.5 5.5 0 0 1 11 0z" fill="#3d9df2"/>
              <circle cx="9.7" cy="8.6" r="0.85" fill="#0d0f12"/>
              <circle cx="14.3" cy="8.6" r="0.85" fill="#0d0f12"/>
              <rect x="6.5" y="12.4" width="11" height="5.4" rx="1.6" fill="#3d9df2"/>
              <rect x="4.4" y="12.4" width="1.7" height="4.6" rx="0.85" fill="#3d9df2"/>
              <rect x="17.9" y="12.4" width="1.7" height="4.6" rx="0.85" fill="#3d9df2"/>
              <g stroke="#3fb96b" stroke-linecap="round" fill="none">
                <path d="M9.2 17.4c-0.7 1.5-1.5 2.4-1.9 4.4" stroke-width="1.2"/>
                <path d="M8.1 19.9c0.5 0.8 0.9 1.3 1.2 2" stroke-width="0.75"/>
                <path d="M11.9 17.5c0.4 1.4-0.2 2.6-0.5 5.2" stroke-width="1.3"/>
                <path d="M11.9 20.3c0.6 0.6 1.2 1.1 1.6 1.9" stroke-width="0.8"/>
                <path d="M14.8 17.4c0.8 1.4 1.6 2.3 2 4.2" stroke-width="1.2"/>
                <path d="M15.9 19.7c-0.3 0.9-0.6 1.5-0.7 2.4" stroke-width="0.75"/>
              </g>
            </svg>
            Root My Android
          </a>
          <p>Scan your Android device and get a rooting / upgrade plan. No email, no password.</p>
        </div>
        <nav class="footer-col" aria-label="Product">
          <h2>Product</h2>
          <a href="/scan">Scan</a>
          <a href="/guides">Guides</a>
          <a href="/roms">ROMs</a>
          <a href="/rooted">Rooted</a>
        </nav>
        <nav class="footer-col" aria-label="Account">
          <h2>Account</h2>
          <a href="/account">Account</a>
          <a href="/halo">Halo</a>
          <a href="/pricing">Pricing</a>
        </nav>
        <nav class="footer-col" aria-label="Legal">
          <h2>Legal</h2>
          <a href="/terms">Terms</a>
          <a href="/privacy">Privacy</a>
          <a href="/refunds">Refunds</a>
        </nav>
      </div>
      <div class="container footer-bottom">
        <span>© {year} Root My Android</span>
        <a href="https://rootmyandroid.com/v1/health" rel="noopener">API</a>
      </div>
    </footer>

    {/* First-party analytics pixel for visitors with JavaScript disabled.
        Same-origin, no cookies — see src/scripts/analytics.ts (app pages)
        and /privacy. */}
    <noscript>
      <img
        src={`/v1/analytics/t.gif?p=${encodeURIComponent(Astro.url.pathname)}`}
        width="1"
        height="1"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </noscript>
  </body>
</html>
