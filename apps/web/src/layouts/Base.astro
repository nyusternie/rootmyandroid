---
// src/layouts/Base.astro — shared shell: header, footer, SEO meta.
// Analytics: no-JS browsers are counted by the first-party pixel at the
// bottom of <body> (no scripts on content pages — see AGENTS.md rule 4).
import '../styles/global.css'
import LangSwitcher from '../components/LangSwitcher.astro'
import ThemeToggle from '../components/ThemeToggle.astro'
import {
  LOCALES,
  LOCALIZED_ROUTES,
  OG_LOCALES,
  alternateLinks,
  defaultPath,
  dictFor,
  localeOf,
  lp,
} from '../i18n/i18n'

interface Props {
  title: string
  description?: string
  // Per-page social/SEO overrides (Profile.astro passes each profile's own
  // art; every other page keeps the sitewide OG card + identity).
  ogType?: string
  ogImage?: string
  ogImageAlt?: string
  ogImageWidth?: number
  ogImageHeight?: number
  // Render the Keep Android Open banner at the very top, incl. its inline
  // dismissal-persistence script (owner ruling 2026-11-08: JS-shipping
  // pages only — /, /account, /audit, /pay, /scan).
  banner?: boolean
}

const {
  title,
  description,
  ogType = 'website',
  ogImage = '/og-image.png',
  ogImageAlt = 'Root My Android — device unlocking assistant and Guardian Angel parental controls',
  ogImageWidth = 1200,
  ogImageHeight = 630,
  banner = false,
} = Astro.props

const pageTitle = title === 'Root My Android' ? title : `${title} — Root My Android`
const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImageAbs = new URL(ogImage, Astro.site)
const year = new Date().getFullYear()

// i18n: current locale + shared chrome dictionary + hreflang set (empty
// for pages that are not localized — see src/i18n/i18n.ts).
const locale = localeOf(Astro.currentLocale)
const d = dictFor(Astro.currentLocale)
const bare = defaultPath(Astro.url.pathname)
const alternates = alternateLinks(Astro.site, Astro.url.pathname)
const metaDescription = description ?? d.common.metaDescription

// Sitewide structured data (JSON-LD). Page-specific schema (e.g.
// SoftwareApplication on the landing page) lives in the page itself.
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Root My Android',
  url: Astro.site,
  logo: new URL('/apple-touch-icon.png', Astro.site).href,
  // Official social profiles — entity resolution for search/answer engines.
  // Add only profiles VERIFIED to exist: X verified via first post
  // 2026-11-05 (rootmyandroid-x-posting skill).
  sameAs: ['https://x.com/RootMyAndroid_'],
}
const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Root My Android',
  url: Astro.site,
}

// Footer nav icons (owner request 2026-11-13): simple hand-drawn stroke
// glyphs, currentColor so each inherits its link's text-faint →
// hover:text-ink transition. Decorative (aria-hidden) — the link text
// carries the meaning.
const footerIcons: Record<string, string> = {
  scan: '<path d="M4 8V4h4M20 8V4h-4M4 16v4h4M20 16v4h-4"/><circle cx="12" cy="12" r="1.6" fill="currentColor" stroke="none"/>',
  rootz: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9l3 3-3 3M12.5 15H17"/>',
  guardian: '<path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/>',
  gurus: '<path d="M4 5h16v11H9l-5 4z"/>',
  harness: '<rect x="4" y="7" width="16" height="12" rx="2"/><path d="M8 3v4M16 3v4M8 12h8M8 15h5"/>',
  parents: '<path d="M12 20s-7-4.5-7-9a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 4.5-7 9-7 9z"/>',
  agents: '<rect x="5" y="8" width="14" height="10" rx="2.5"/><path d="M12 8V5M9 5h6"/><circle cx="9.5" cy="13" r="1" fill="currentColor" stroke="none"/><circle cx="14.5" cy="13" r="1" fill="currentColor" stroke="none"/>',
  mcp: '<path d="M9 6 4 12l5 6M15 6l5 6-5 6"/>',
  models: '<path d="M12 3 4 7.5l8 4.5 8-4.5zM4 12l8 4.5 8-4.5M4 16.5 12 21l8-4.5"/>',
  guides: '<path d="M5 4h11a2 2 0 0 1 2 2v14H7a2 2 0 0 1-2-2zM18 16H7a2 2 0 0 0-2 2"/>',
  why: '<circle cx="12" cy="12" r="9"/><path d="M15.5 8.5A3.5 3.5 0 0 0 9 10.5c0 1.5 1 2 3 2.5"/>',
  roms: '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="3"/>',
  devices: '<rect x="7" y="3" width="10" height="18" rx="2"/><path d="M11 18h2"/>',
  terms: '<path d="M6 3h8l4 4v14H6zM14 3v4h4M9 11h6M9 15h6"/>',
  privacy: '<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>',
  refunds: '<path d="M4 12a8 8 0 1 0 2.3-5.7M6 3v4h4"/>',
  marketplace: '<path d="M20 13.5 13.5 20a2 2 0 0 1-2.8 0L4 13.3V4h9.3l6.7 6.7a2 2 0 0 1 0 2.8z"/><circle cx="8.5" cy="8.5" r="1.2" fill="currentColor" stroke="none"/>',
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    {/* hreflang alternates — emitted only when this page exists in every
        locale (LOCALIZED_ROUTES); includes x-default → the English URL. */}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Root My Android" />
    <meta property="og:locale" content={OG_LOCALES[locale]} />
    {LOCALIZED_ROUTES.includes(bare) &&
      LOCALES.filter((l) => l !== locale).map((l) => (
        <meta property="og:locale:alternate" content={OG_LOCALES[l]} />
      ))}
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageAbs} />
    <meta name="theme-color" content="#0d0f12" />
    {/* Theme (owner order 2026-11-24): the stored choice wins, else the OS
        preference; applied before first paint so there is no flash. The
        same inline block handles the header/footer toggle clicks. This is
        the sanctioned exception to the content-page zero-JS rule — a
        persistent theme cannot be done in static HTML + CSS alone. */}
    <script is:inline>
      (() => {
        const KEY = 'rma.theme'
        const root = document.documentElement
        const meta = document.querySelector('meta[name="theme-color"]')
        let stored = null
        try {
          stored = localStorage.getItem(KEY)
        } catch {
          /* storage disabled — follow the OS */
        }
        const apply = (theme) => {
          root.dataset.theme = theme
          if (meta) meta.setAttribute('content', theme === 'light' ? '#f7f8fa' : '#0d0f12')
        }
        apply(
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark',
        )
        document.addEventListener('click', (event) => {
          const target = event.target instanceof Element ? event.target.closest('[data-theme-toggle]') : null
          if (!target) return
          const next = root.dataset.theme === 'light' ? 'dark' : 'light'
          apply(next)
          try {
            localStorage.setItem(KEY, next)
          } catch {
            /* storage disabled — the choice lasts for this page */
          }
        })
      })()
    </script>
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
    {/* Per-page head additions (e.g. the rel="alternate" Markdown link on
        guide pages). Pages that pass nothing here are unaffected. */}
    <slot name="head" />
    {/* Keep Android Open banner dismissal persistence — emitted ONLY on
        banner pages (the `banner` prop). is:inline + synchronous in <head>
        = runs before first paint: if the banner was dismissed earlier it
        never flashes back (owner ruling 2026-11-08: once dismissed it must
        not reappear on later page loads — static HTML + CSS alone cannot
        persist state, hence this one inline script; no-JS users keep the
        checkbox per-view dismiss). The delegated click handler persists
        the dismissal and hides immediately. Stored value is the campaign
        slug — a future campaign bumps the slug so previously-dismissed
        visitors see the new banner. */}
    {
      banner && (
        <script is:inline>
          ;(function () {
            var KEY = 'rma.banner.dismissed'
            var CAMPAIGN = 'keep-android-open'
            try {
              if (localStorage.getItem(KEY) === CAMPAIGN)
                document.documentElement.classList.add('kao-dismissed')
            } catch (e) {}
            document.addEventListener('click', function (e) {
              if (e.target && e.target.closest && e.target.closest('[data-kao-dismiss]')) {
                try {
                  localStorage.setItem(KEY, CAMPAIGN)
                } catch (err) {}
                document.documentElement.classList.add('kao-dismissed')
              }
            })
          })()
        </script>
      )
    }
  </head>
  <body>
    {/* Keep Android Open campaign banner — F-Droid-style strip at the very
        top, above the sticky site header. Rendered ONLY on pages passing the
        `banner` prop (owner ruling 2026-11-08: JS-shipping pages — /,
        /account, /audit, /pay, /scan; never on zero-JS content pages).
        Dismissal: the <label> toggles a clipped checkbox and Tailwind
        has-checked:hidden hides the strip instantly without JS; the inline
        head script (end of <head>) additionally persists the dismissal to
        localStorage and re-hides via html.kao-dismissed before first paint,
        so a dismissed banner does not reappear on later page loads (owner
        ruling 2026-11-08). Input and label must be SIBLINGS — Tailwind
        peer-* compiles to the ~ sibling combinator. Copy + sources
        documented in src/i18n/en/common.ts (bannerText). */}
    {
      banner && (
        <div class="kao-banner border-b border-warn/45 bg-warn/12 text-[0.92rem] text-warn-ink has-checked:hidden">
          <div class="container flex max-w-[60rem] items-center justify-between gap-[0.75rem] py-[0.6rem]">
            <p class="m-0">
              {d.common.bannerText}{' '}
              <a
                href="https://keepandroidopen.org/"
                rel="noopener"
                class="font-semibold text-inherit underline underline-offset-2 hover:no-underline"
              >
                keepandroidopen.org
              </a>
            </p>
            <input type="checkbox" id="kao-banner-toggle" class="peer/kao sr-only" />
            <label
              for="kao-banner-toggle"
              data-kao-dismiss=""
              aria-label={d.common.bannerDismiss}
              class="shrink-0 cursor-pointer rounded-[0.35rem] p-[0.3rem] leading-none hover:bg-warn/20 peer-focus-visible/kao:outline-2 peer-focus-visible/kao:outline-accent"
            >
              <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
                <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
            </label>
          </div>
        </div>
      )
    }
    <header class="site-header">
      <div class="container">
        <a class="brand whitespace-nowrap text-[1.2rem] min-[560px]:text-[1.35rem] min-[1024px]:text-[2.7rem]" href="/">
          {/* Brand mark: SU superhero (green body, red cape, yellow SU
              diamond) — identical to /icon.svg. Legacy blue root-tendril
              robot retired per brand canon 2026-11-04. Owner order
              2026-11-24: header mark doubled (48px) with the wordmark
              scaled to match at desktop widths. */}
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6.8 12.6 3.6 20.8c1.6-0.9 2.6-1.2 3.4-1.3zM17.2 12.6l3.2 8.2c-1.6-0.9-2.6-1.2-3.4-1.3z" fill="#e23a3a"/>
            <path d="M9.1 6.2 7.7 4.1M14.9 6.2l1.4-2.1" stroke="#3ddc84" stroke-width="1.1" stroke-linecap="round"/>
            <path d="M6.5 11a5.5 5.5 0 0 1 11 0z" fill="#3ddc84"/>
            <circle cx="9.7" cy="8.6" r="0.85" fill="#0d0f12"/>
            <circle cx="14.3" cy="8.6" r="0.85" fill="#0d0f12"/>
            <rect x="6.5" y="12.4" width="11" height="5.4" rx="1.6" fill="#3ddc84"/>
            <rect x="4.4" y="12.4" width="1.7" height="4.6" rx="0.85" fill="#3ddc84"/>
            <rect x="17.9" y="12.4" width="1.7" height="4.6" rx="0.85" fill="#3ddc84"/>
            <path d="M12 12.6l2.8 2.8-2.8 2.8-2.8-2.8z" fill="#f7d154"/>
            <text x="12" y="16.35" font-family="Arial, Helvetica, sans-serif" font-size="2.7" font-weight="900" fill="#e23a3a" text-anchor="middle" letter-spacing="-0.1">SU</text>
            <rect x="8.6" y="17.9" width="2.4" height="3.4" rx="1.2" fill="#3ddc84"/>
            <rect x="13" y="17.9" width="2.4" height="3.4" rx="1.2" fill="#3ddc84"/>
          </svg>
          Root My Android
        </a>
        <nav class="nav gap-[0.75rem] min-[560px]:gap-[1.25rem]">
          <a class="hidden min-[560px]:inline" href={lp(locale, '/guides')}>{d.common.navGuides}</a>
          <a class="hidden min-[560px]:inline" href={lp(locale, '/roms')}>{d.common.navRoms}</a>
          <a class="hidden min-[560px]:inline" href={lp(locale, '/gurus')}>{d.common.navGurus}</a>
          <a class="btn btn-primary btn-sm" href={lp(locale, '/scan')}>{d.common.navScan}</a>
          {/* Narrow-screen menu (owner request 2026-11-24): the three text
              links move into a zero-JS <details> dropdown so the brand no
              longer wraps at 390px. Same pattern as LangSwitcher. */}
          <details class="group relative min-[560px]:hidden">
            <summary
              aria-label={d.common.navMenu}
              class="flex cursor-pointer list-none items-center justify-center rounded-[0.5rem] border border-line bg-raise p-[0.4rem] text-dim transition-[border-color,color] duration-150 hover:border-faint hover:text-ink [&::-webkit-details-marker]:hidden"
            >
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <path d="M2 4.5h14M2 9h14M2 13.5h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
              </svg>
            </summary>
            <div
              class="absolute right-0 z-50 mt-[0.45rem] w-[11rem] rounded-[0.6rem] border border-line bg-raise p-[0.35rem] shadow-[0_12px_32px_rgba(0,0,0,0.45)]"
            >
              <a class="block rounded-[0.4rem] px-[0.6rem] py-[0.45rem] hover:bg-inset hover:no-underline" href={lp(locale, '/guides')}>{d.common.navGuides}</a>
              <a class="block rounded-[0.4rem] px-[0.6rem] py-[0.45rem] hover:bg-inset hover:no-underline" href={lp(locale, '/roms')}>{d.common.navRoms}</a>
              <a class="block rounded-[0.4rem] px-[0.6rem] py-[0.45rem] hover:bg-inset hover:no-underline" href={lp(locale, '/gurus')}>{d.common.navGurus}</a>
            </div>
          </details>
          {/* Language dropdown (zero-JS <details> toggle, flags + locale
              names — see src/components/LangSwitcher.astro). Targets the
              same page when localized, else the locale home. Hidden on
              narrow screens — the footer switcher below is the mobile
              path. */}
          <span class="hidden items-center min-[1024px]:flex">
            <ThemeToggle />
          </span>
          <span class="ml-[0.25rem] hidden items-center border-l border-line pl-[0.9rem] min-[680px]:flex">
            <LangSwitcher />
          </span>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <a class="brand" href="/">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6.8 12.6 3.6 20.8c1.6-0.9 2.6-1.2 3.4-1.3zM17.2 12.6l3.2 8.2c-1.6-0.9-2.6-1.2-3.4-1.3z" fill="#e23a3a"/>
              <path d="M9.1 6.2 7.7 4.1M14.9 6.2l1.4-2.1" stroke="#3ddc84" stroke-width="1.1" stroke-linecap="round"/>
              <path d="M6.5 11a5.5 5.5 0 0 1 11 0z" fill="#3ddc84"/>
              <circle cx="9.7" cy="8.6" r="0.85" fill="#0d0f12"/>
              <circle cx="14.3" cy="8.6" r="0.85" fill="#0d0f12"/>
              <rect x="6.5" y="12.4" width="11" height="5.4" rx="1.6" fill="#3ddc84"/>
              <rect x="4.4" y="12.4" width="1.7" height="4.6" rx="0.85" fill="#3ddc84"/>
              <rect x="17.9" y="12.4" width="1.7" height="4.6" rx="0.85" fill="#3ddc84"/>
              <path d="M12 12.6l2.8 2.8-2.8 2.8-2.8-2.8z" fill="#f7d154"/>
              <text x="12" y="16.35" font-family="Arial, Helvetica, sans-serif" font-size="2.7" font-weight="900" fill="#e23a3a" text-anchor="middle" letter-spacing="-0.1">SU</text>
              <rect x="8.6" y="17.9" width="2.4" height="3.4" rx="1.2" fill="#3ddc84"/>
              <rect x="13" y="17.9" width="2.4" height="3.4" rx="1.2" fill="#3ddc84"/>
            </svg>
            Root My Android
          </a>
          <p>{d.common.footerTagline}</p>
        </div>
        <nav class="footer-col" aria-label={d.common.footerProduct}>
          <h2>{d.common.footerProduct}</h2>
          <a href={lp(locale, '/scan')}><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={footerIcons.scan} />{d.common.footerScan}</a>
          <a href={lp(locale, '/rootz')}><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={footerIcons.rootz} />{d.common.footerRootz}</a>
          <a href={lp(locale, '/guardian-angel')}><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={footerIcons.guardian} />{d.common.footerGa}</a>
          <a href={lp(locale, '/gurus')}><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={footerIcons.gurus} />{d.common.footerGurus}</a>
          <a href={lp(locale, '/harness')}><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={footerIcons.harness} />{d.common.footerHarness}</a>
          <a href={lp(locale, '/parents')}><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={footerIcons.parents} />{d.common.footerParents}</a>
          <a href={lp(locale, '/agents')}><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={footerIcons.agents} />{d.common.footerAgents}</a>
          <a href={lp(locale, '/mcp')}><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={footerIcons.mcp} />{d.common.footerMcp}</a>
        </nav>
        <nav class="footer-col" aria-label={d.common.footerResources}>
          <h2>{d.common.footerResources}</h2>
          <a href={lp(locale, '/models')}><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={footerIcons.models} />{d.common.footerModels}</a>
          <a href={lp(locale, '/guides')}><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={footerIcons.guides} />{d.common.footerGuides}</a>
          <a href={lp(locale, '/why')}><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={footerIcons.why} />{d.common.footerWhy}</a>
          <a href={lp(locale, '/roms')}><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={footerIcons.roms} />{d.common.footerRoms}</a>
          <a href={lp(locale, '/devices')}><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={footerIcons.devices} />{d.common.footerDevices}</a>
          <a href={lp(locale, '/marketplace')}><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={footerIcons.marketplace} />{d.common.footerMarketplace}</a>
        </nav>
        <nav class="footer-col" aria-label={d.common.footerLegal}>
          <h2>{d.common.footerLegal}</h2>
          <a href={lp(locale, '/terms')}><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={footerIcons.terms} />{d.common.footerTerms}</a>
          <a href={lp(locale, '/privacy')}><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={footerIcons.privacy} />{d.common.footerPrivacy}</a>
          <a href={lp(locale, '/refunds')}><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={footerIcons.refunds} />{d.common.footerRefunds}</a>
        </nav>
