---
// src/components/pages/Rootz.astro — Rootz product-page markup, shared by
// every locale (route wrappers in src/pages/rootz.astro and
// src/pages/<locale>/). Copy comes from src/i18n/<locale>/rootz.ts.
// PRODUCT page for Rootz (the power-user toolkit; Colonel Su's product —
// mascot named 2026-11-08). AI-status labels follow the AI-positioning
// handoff (2026-11-07): every AI capability carries a status label
// (LIVE / LABS / PLANNED) and no planned capability is presented as part of
// the currently purchasable feature set. The capability-status table mirrors
// the Live capability matrix on /agents (agents.astro) — keep the two in
// sync until backend capability metadata ships. Tier facts mirror
// src/i18n/<locale>/pricing.ts (the owner-ruled authority) and the
// landing-page FAQ — keep them in sync. Encryption wording mirrors Terms §7
// per the owner ruling 2026-11-07 that ALL product data is client-side
// encrypted. FAQ entries render visibly below AND feed the FAQPage JSON-LD —
// the two stay text-identical per locale.
import Base from '../../layouts/Base.astro'
import { dictFor, localeOf, lp } from '../../i18n/i18n'

const locale = localeOf(Astro.currentLocale)
const d = dictFor(Astro.currentLocale)

const { freeTools, faqs } = d.rootz

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Rootz',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Android',
  url: `https://rootmyandroid.com${lp(locale, '/rootz')}`,
  description: d.rootz.schemaDescription,
}
---

<Base title={d.rootz.metaTitle} description={d.rootz.metaDescription}>
  <section class="hero relative before:pointer-events-none before:absolute before:inset-x-0 before:-top-24 before:h-[32rem] before:bg-[radial-gradient(60%_70%_at_70%_30%,rgba(61,220,132,0.14),transparent_70%)] before:content-['']">
    <div class="container hero-grid relative grid items-center gap-8 min-[720px]:grid-cols-[1.05fr_0.95fr]">
      <div>
        <h1>{d.rootz.heroH1Before}<span class="hl text-accent">{d.rootz.heroH1Highlight}</span>{d.rootz.heroH1After}</h1>
        <p class="lede">
          {d.rootz.heroLede}
        </p>
        <div class="row mt-7">
          <a class="btn btn-primary" href={lp(locale, '/download')}>{d.rootz.heroDownload}</a>
          <a class="btn" href={lp(locale, '/pricing')}>{d.rootz.heroPlans}</a>
        </div>
      </div>
      <div class="hero-art">
        <img class="block h-auto w-full rounded-[1.25rem] shadow-[0_12px_32px_rgba(0,0,0,0.45)]"
          src="/img/colonel-su-terminal.webp"
          alt={d.rootz.heroImgAlt}
          width="880"
          height="880"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class="container pt-10 pb-8">
    <div class="panel">
      <h2 class="mt-0">{d.rootz.labelsH2}</h2>
      <p class="muted mb-0">
        {d.rootz.labelsPIntro}<strong class="text-ok">{d.rootz.labelsLive}</strong>{d.rootz.labelsLiveMeans}<strong class="text-accent">{d.rootz.labelsLabs}</strong>{d.rootz.labelsLabsMeans}<strong>{d.rootz.labelsPlanned}</strong>{d.rootz.labelsPlannedMeans}
      </p>
    </div>
  </section>

  <section class="container pb-8">
    <h2>{d.rootz.freeH2} <span class="ml-2 inline-block rounded-full border border-line px-2 py-[0.1rem] align-middle text-[0.72rem] font-bold tracking-[0.08em] text-ok">{d.rootz.labelsLive}</span></h2>
    <p>
      {d.rootz.freeP}
    </p>
    <ul class="mt-3 grid list-none gap-[0.4rem] p-0 min-[560px]:grid-cols-2 min-[860px]:grid-cols-3">
      {freeTools.map((t) => (
        <li class="relative pl-[1.6rem] before:absolute before:left-0 before:font-bold before:text-ok before:content-['✓']">{t}</li>
      ))}
    </ul>
  </section>

  <section class="container pb-8">
    <h2>{d.rootz.proH2} <span class="ml-2 inline-block rounded-full border border-line px-2 py-[0.1rem] align-middle text-[0.72rem] font-bold tracking-[0.08em] text-ok">{d.rootz.labelsLive}</span></h2>
    <p>
      {d.rootz.proPBefore}<strong>{d.rootz.proPStrong}</strong>{d.rootz.proPMid}<a href={lp(locale, '/pricing')}>{d.rootz.proPLink}</a>{d.rootz.proPEnd}
    </p>
  </section>

  <section class="container pb-8">
    <h2>{d.rootz.aiH2} <span class="ml-2 inline-block rounded-full border border-line px-2 py-[0.1rem] align-middle text-[0.72rem] font-bold tracking-[0.08em] muted">{d.rootz.labelsPlanned}</span></h2>
    <p>
      {d.rootz.aiP1}
    </p>
    <p class="panel text-[1.1rem]">
      <strong>{d.rootz.aiPromise}</strong>
    </p>
    <p>
      {d.rootz.aiColonelBefore}<strong>{d.rootz.aiColonelStrong}</strong>{d.rootz.aiColonelRest}
    </p>
    <div class="grid-3 steps-grid mt-6">
      {d.rootz.aiCards.map((c) => (
        <div class="panel">
          <h3>{c.h}</h3>
          <p class="muted">
            {c.p}
          </p>
        </div>
      ))}
    </div>
  </section>

  <section class="container pb-8">
    <h2>{d.rootz.agentsH2}</h2>
    <div class="grid gap-5 min-[720px]:grid-cols-2 mt-6">
      {d.rootz.agentCards.map((c) => (
        <div class="panel">
          <h3>{c.h}</h3>
          <ul class="muted">
            {c.lis.map((li) => (
              <li>{typeof li === 'string' ? li : <><strong>{li.s}</strong>{li.t}</>}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="muted mt-5">
      {d.rootz.agentsNote}
    </p>
  </section>

  <section class="container pb-8">
    <h2>{d.rootz.capH2}</h2>
    <div class="table-wrap overflow-x-auto">
      <table class="w-full min-w-[40rem] border-collapse text-[0.92rem]">
        <caption class="faint small mb-2 text-left">
          {d.rootz.capCaption}
        </caption>
        <thead>
          <tr>
            <th class="border border-line bg-raise px-3 py-[0.6rem] align-top text-left" scope="col">{d.rootz.capHeaders[0]}</th>
            <th class="border border-line bg-raise px-3 py-[0.6rem] align-top text-left" scope="col">{d.rootz.capHeaders[1]}</th>
            <th class="border border-line bg-raise px-3 py-[0.6rem] align-top text-left" scope="col">{d.rootz.capHeaders[2]}</th>
            <th class="border border-line bg-raise px-3 py-[0.6rem] align-top text-left" scope="col">{d.rootz.capHeaders[3]}</th>
          </tr>
        </thead>
        <tbody>
          {d.rootz.capRows.map((r) => (
            <tr>
              <th class="border border-line px-3 py-[0.6rem] align-top text-left font-semibold" scope="row">{r.name}</th>
              <td class:list={['border border-line px-3 py-[0.6rem] align-top text-left font-semibold', r.status.startsWith('LIVE') ? 'text-ok' : r.status.startsWith('LABS') ? 'text-accent' : '']}>{r.status}</td>
              <td class="border border-line px-3 py-[0.6rem] align-top text-left">{r.dest}</td>
              <td class="border border-line px-3 py-[0.6rem] align-top text-left">{r.authority}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="container pb-8">
    <h2>{d.rootz.secH2}</h2>
    <ul>
      {d.rootz.secLis.map((li) => (
        <li>{typeof li === 'string' ? li : <strong>{li.s}</strong>}</li>
      ))}
    </ul>
  </section>

  <section class="container pb-8">
    <h2>{d.rootz.encH2}</h2>
    <p>
      <strong>{d.rootz.encP1Strong}</strong>{d.rootz.encP1Rest}
    </p>
    <p>
      {d.rootz.encP2Before}<a href={lp(locale, '/scan')}>{d.rootz.encP2Link}</a>{d.rootz.encP2Rest}
    </p>
    <p>
      {d.rootz.encP3}
    </p>
  </section>

  <section class="container pb-8">
    <h2>{d.rootz.hwH2}</h2>
    <p>
      {d.rootz.hwP1}
    </p>
    <ul>
      {d.rootz.hwLis.map((li) => (
        <li>{li.t}<strong>{li.s}</strong></li>
      ))}
    </ul>
    <p class="muted">
      {d.rootz.hwNote}
    </p>
  </section>

  <section class="container pb-8">
    <h2>{d.rootz.billH2}</h2>
    <p>
      {d.rootz.billP1}
    </p>
    <p class="panel">
      <strong>{d.rootz.billPanelStrong}</strong>{d.rootz.billPanelRest}
    </p>
  </section>

  <section class="container faq-section pb-12">
    <h2>{d.rootz.faqH2}</h2>
    {faqs.map((f) => (
      <details class="panel faq-item mt-3">
        <summary class="cursor-pointer font-semibold">{f.q}</summary>
        <p class="muted mt-3">{f.a}</p>
      </details>
    ))}
    <p class="mt-8">
      <a class="btn btn-primary" href={lp(locale, '/download')}>{d.rootz.faqDownload}</a>
      <a class="btn ml-3" href={lp(locale, '/scan')}>{d.rootz.faqScan}</a>
    </p>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />

</Base>
