---
// src/components/pages/Download.astro — download-page markup, shared by
// every locale (route wrappers in src/pages/download.astro and
// src/pages/<locale>/). Static content page, zero JS. Copy comes from
// src/i18n/<locale>/download.ts.
//
// Store chips: icon paths vendored from simple-icons v13 (CC0). The Apple
// and Google Play logos remain trademarks of their respective owners,
// referenced nominatively to mark upcoming store availability of the
// featured client (owner ruling 2026-11-13: chips on Root My Android only —
// Rootz and Guardian Angel are sideloaded).
import Base from '../../layouts/Base.astro'
import { dictFor } from '../../i18n/i18n'

const d = dictFor(Astro.currentLocale)
---

<Base title={d.download.metaTitle} description={d.download.metaDescription}>
  <section
    class="hero relative before:pointer-events-none before:absolute before:inset-x-0 before:-top-24 before:h-[30rem] before:bg-[radial-gradient(60%_70%_at_60%_30%,rgba(61,220,132,0.14),transparent_70%)] before:content-['']"
  >
    <div class="container relative">
      <h1>{d.download.h1}</h1>
      <p class="lede">{d.download.tagline}</p>

      <!-- Featured client -->
      <div class="panel mt-8 grid items-center gap-8 p-6 min-[720px]:grid-cols-[1.05fr_0.95fr] min-[720px]:p-8">
        <div>
          <p class="m-0 text-[0.8rem] font-semibold uppercase tracking-[0.14em] text-dim">
            {d.download.featuredEyebrow}
          </p>
          <h2 class="mb-2 mt-1 text-[1.9rem]">{d.download.featuredTitle}</h2>
          <p>
            <code>com.rootmyandroid</code>{d.download.featuredDescAfter}
          </p>
          <p class="row m-0 items-center gap-2 text-[0.9rem] text-dim">
            <span
              class="inline-block h-[0.55rem] w-[0.55rem] animate-pulse-dot rounded-full bg-ok motion-reduce:animate-none"
              aria-hidden="true"></span>
            {d.download.featuredStatus}
          </p>
          <a
            class="btn btn-primary mt-5 block px-8 py-5 text-center text-[1.2rem]"
            href="https://github.com/nyusternie/rootmyandroid/releases/download/android-apk/rootmyandroid-release.apk"
            >{d.download.featuredLink}</a
          >
          <p class="faint mt-3 text-[0.85rem]">{d.download.featuredNote}</p>

          <!-- Store chips — coming soon, client only (Rootz / Guardian Angel stay sideload-only) -->
          <div class="row mt-5 items-stretch gap-3">
            <span
              class="flex items-center gap-2 rounded-[0.5rem] border border-dashed border-line px-3 py-2 text-[0.85rem] text-faint"
              aria-disabled="true">
              <svg class="h-[1.15rem] w-[1.15rem] fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M8.8086 14.9194l6.1107-11.0368c.0837-.1513.1682-.302.2437-.4584.0685-.142.1267-.2854.1646-.4403.0803-.3259.0588-.6656-.066-.9767-.1238-.3095-.3417-.5678-.6201-.7355a1.4175 1.4175 0 0 0-.921-.1924c-.3207.043-.6135.1935-.8443.4288-.1094.1118-.1996.2361-.2832.369-.092.1463-.175.2979-.259.4492l-.3864.6979-.3865-.6979c-.0837-.1515-.1667-.303-.2587-.4492-.0837-.1329-.1739-.2572-.2835-.369-.2305-.2353-.5233-.3857-.844-.429a1.4181 1.4181 0 0 0-.921.1926c-.2784.1677-.4964.426-.6203.7355-.1246.311-.1461.6508-.066.9767.038.155.0962.2984.1648.4403.0753.1564.1598.307.2437.4584l1.248 2.2543-4.8625 8.7825H2.0295c-.1676 0-.3351-.0007-.5026.0092-.1522.009-.3004.0284-.448.0714-.3108.0906-.5822.2798-.7783.548-.195.2665-.3006.5929-.3006.9279 0 .3352.1057.6612.3006.9277.196.2683.4675.4575.7782.548.1477.043.296.0623.4481.0715.1675.01.335.009.5026.009h13.0974c.0171-.0357.059-.1294.1-.2697.415-1.4151-.6156-2.843-2.0347-2.843zM3.113 18.5418l-.7922 1.5008c-.0818.1553-.1644.31-.2384.4705-.067.1458-.124.293-.1611.452-.0785.3346-.0576.6834.0645 1.0029.1212.3175.3346.583.607.7549.2727.172.5891.2416.9013.1975.3139-.044.6005-.1986.8263-.4402.1072-.1148.1954-.2424.2772-.3787.0902-.1503.1714-.3059.2535-.4612L6 19.4636c-.0896-.149-.9473-1.4704-2.887-.9218m20.5861-3.0056a1.4707 1.4707 0 0 0-.779-.5407c-.1476-.0425-.2961-.0616-.4483-.0705-.1678-.0099-.3352-.0091-.503-.0091H18.648l-4.3891-7.817c-.6655.7005-.9632 1.485-1.0773 2.1976-.1655 1.0333.0367 2.0934.546 3.0004l5.2741 9.3933c.084.1494.167.299.2591.4435.0837.131.1739.2537.2836.364.231.2323.5238.3809.8449.4232.3192.0424.643-.0244.9217-.1899.2784-.1653.4968-.4204.621-.7257.1246-.3072.146-.6425.0658-.9641-.0381-.1529-.0962-.2945-.165-.4346-.0753-.1543-.1598-.303-.2438-.4524l-1.216-2.1662h1.596c.1677 0 .3351.0009.5029-.009.1522-.009.3007-.028.4483-.0705a1.4707 1.4707 0 0 0 .779-.5407A1.5386 1.5386 0 0 0 24 16.452a1.539 1.539 0 0 0-.3009-.9158Z"
                ></path>
              </svg>
              <span class="font-semibold">{d.download.appStoreName}</span>
              <span>{d.download.comingSoon}</span>
            </span>
            <span
              class="flex items-center gap-2 rounded-[0.5rem] border border-dashed border-line px-3 py-2 text-[0.85rem] text-faint"
              aria-disabled="true">
              <svg class="h-[1.15rem] w-[1.15rem] fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M22.018 13.298l-3.919 2.218-3.515-3.493 3.543-3.521 3.891 2.202a1.49 1.49 0 0 1 0 2.594zM1.337.924a1.486 1.486 0 0 0-.112.568v21.017c0 .217.045.419.124.6l11.155-11.087L1.337.924zm12.207 10.065l3.258-3.238L3.45.195a1.466 1.466 0 0 0-.946-.179l11.04 10.973zm0 2.067l-11 10.933c.298.036.612-.016.906-.183l13.324-7.54-3.23-3.21z"
                ></path>
              </svg>
              <span class="font-semibold">{d.download.playStoreName}</span>
              <span>{d.download.comingSoon}</span>
            </span>
          </div>
        </div>
        <div class="relative mx-auto w-full max-w-[17rem]">
          <span
            class="absolute inset-0 -z-10 animate-support-ping rounded-full bg-ok/25 blur-2xl motion-reduce:animate-none"
            aria-hidden="true"></span>
          <img
            src="/img/hero-su.webp"
            width="880"
            height="880"
            alt={d.download.featuredArtAlt}
            class="relative mx-auto block w-full animate-float rounded-[1rem] motion-reduce:animate-none"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="container pb-12">
    <h2 class="mb-1">{d.download.secondaryHeading}</h2>
    <p class="faint">{d.download.secondaryNote}</p>

    <div class="mt-4 grid gap-4 min-[720px]:grid-cols-2">
      <div class="panel m-0 animate-scan-in motion-reduce:animate-none">
        <h3>{d.download.rootzH2}</h3>
        <p>
          <code>com.rootmyandroid</code>{d.download.rootzDescAfter}
        </p>
        <a
          class="btn"
          href="https://github.com/nyusternie/rootmyandroid/releases/latest/download/rooted-release.apk"
          >{d.download.rootzLink}</a
        >
      </div>
      <div class="panel m-0 animate-scan-in motion-reduce:animate-none">
        <div class="flex items-start gap-4">
          <img
            src="/img/brand/guardian-angel.webp"
            width="512"
            height="512"
            alt={d.download.guardianArtAlt}
            class="h-[4.5rem] w-[4.5rem] shrink-0 rounded-[0.75rem]"
            loading="lazy"
          />
          <div>
            <h3 class="mt-0">{d.download.guardianH2}</h3>
            <p>
              <code>com.rootmyandroid.guardian_angel</code>{d.download.guardianDescAfter}
            </p>
          </div>
        </div>
        <a
          class="btn"
          href="https://github.com/nyusternie/rootmyandroid/releases/latest/download/guardian-release.apk"
          >{d.download.guardianLink}</a
        >
      </div>
    </div>

    <h2>{d.download.installH2}</h2>
    <ol>
      <li>{d.download.installStep1}</li>
      <li>{d.download.installStep2Before}<strong>{d.download.installStep2Strong}</strong>{d.download.installStep2After}</li>
      <li>{d.download.installStep3Before}<strong>{d.download.installStep3Strong}</strong>{d.download.installStep3After}</li>
    </ol>
    <p>
      {d.download.requiresBefore}<a href="https://github.com/nyusternie/rootmyandroid/releases/latest"
        >{d.download.requiresLink}</a
      >{d.download.requiresAfter}
    </p>
    <p class="faint">
      {d.download.previewNote}
    </p>
  </section>
</Base>
