---
// src/components/pages/Download.astro — download-page markup, shared by
// every locale (route wrappers in src/pages/downloads.astro and
// src/pages/<locale>/). Static content page; owner instruction
// 2026-11-13 adds ONE interactive element: the sideloading modal that
// intercepts every APK download button (src/scripts/downloads.ts). Copy
// comes from src/i18n/<locale>/download.ts.
//
// Owner instruction 2026-11-24: full makeover — three-app grid, hero art,
// orbit rings, install timeline, verification panel. Every APK button
// carries data-apk-link (modal intercept) + data-apk-name / data-apk-file
// (modal label + per-file analytics detail) + a PER-APP click event name
// (apk_download_click_<slug>, detail = app slug) so the admin's existing
// "Click events" card reports each app separately with no admin change.
// The modal's Continue anchor
// carries a STATIC data-rma-event="download" so the existing dashboard
// breakdown (name='download', detail=filename) counts real downloads;
// downloads.ts only sets its detail dynamically (analytics.ts binds
// [data-rma-event] once at load — a runtime-added attribute would not bind).
//
// Store chips: icon paths vendored from simple-icons v13 (CC0). The Apple
// and Google Play logos remain trademarks of their respective owners,
// referenced nominatively to mark upcoming store availability of the
// featured client (owner ruling 2026-11-13: chips on Root My Android only —
// Rootz and Guardian Angel are sideloaded).
import Base from '../../layouts/Base.astro'
import { dictFor, localeOf, lp } from '../../i18n/i18n'

const locale = localeOf(Astro.currentLocale)
const d = dictFor(Astro.currentLocale)

const RELEASES = 'https://github.com/nyusternie/rootmyandroid/releases'

// Three shipped APKs. Links verified live 2026-11-24:
//   android-apk        rolling prerelease, appstore flavor (monetized build)
//   rootz-preview-apk  rolling Rootz build, package com.rootmyandroid.rootz
//   android-v1.0.0     the only published Guardian Angel preview
const apps = [
  {
    slug: 'rootmyandroid',
    click: 'apk_download_click_rootmyandroid',
    name: 'Root My Android',
    pkg: 'com.rootmyandroid',
    href: `${RELEASES}/download/android-apk/rootmyandroid.apk`,
    file: 'rootmyandroid.apk',
    art: '/img/hero-su.webp',
    alt: d.download.featuredArtAlt,
    badge: d.download.featuredBadge,
    points: [
      d.download.featuredPoint1,
      d.download.featuredPoint2,
      d.download.featuredPoint3,
    ],
    featured: true,
  },
  {
    slug: 'rootz',
    click: 'apk_download_click_rootz',
    name: d.download.rootzH2,
    pkg: 'com.rootmyandroid.rootz',
    href: `${RELEASES}/download/rootz-preview-apk/rootz.apk`,
    file: 'rootz.apk',
    art: '/img/brand/colonel-su-staff.webp',
    alt: d.download.rootzArtAlt,
    badge: d.download.rootzBadge,
    points: [
      d.download.rootzPoint1,
      d.download.rootzPoint2,
      d.download.rootzPoint3,
    ],
    featured: false,
  },
  {
    slug: 'guardian-angel',
    click: 'apk_download_click_guardian_angel',
    name: d.download.guardianH2,
    pkg: 'com.rootmyandroid.guardian_angel',
    href: `${RELEASES}/download/guardian-angel-apk/guardian-angel.apk`,
    file: 'guardian-angel.apk',
    art: '/img/brand/guardian-angel.webp',
    alt: d.download.guardianArtAlt,
    badge: d.download.guardianBadge,
    points: [
      d.download.guardianPoint1,
      d.download.guardianPoint2,
      d.download.guardianPoint3,
    ],
    featured: false,
  },
]

// Signing certificate (public: the current key is in
// .github/workflows/android.yml's release body). The Rootz preview is
// debug-signed by its workflow, so it has no stable fingerprint to publish.
// Never translated.
const KEY_CURRENT = '1c59c4331c9c8f1fc0e41578ef47ac404396ba7596f5a4c8e94528d4886bceca'
---

<Base title={d.download.metaTitle} description={d.download.metaDescription}>
  <section class="hero dl-hero">
    <div class="container relative grid items-center gap-10 min-[720px]:grid-cols-[1.04fr_0.96fr]">
      <div>
        <p class="m-0 text-[0.78rem] font-semibold uppercase tracking-[0.16em] text-ok">
          {d.download.featuredEyebrow}
        </p>
        <h1>{d.download.h1}</h1>
        <p class="lede text-body">{d.download.tagline}</p>

        <div class="row mt-6 items-center">
          <a
            class="btn btn-primary dl-cta px-7 py-4 text-[1.05rem]"
            href={apps[0].href}
            data-apk-link
            data-apk-name={apps[0].name}
            data-apk-file={apps[0].file}
            data-rma-event={apps[0].click}
            data-rma-event-detail={apps[0].slug}
            >{d.download.heroCta}</a
          >
          <a class="btn" href="#install">{d.download.heroInstall}</a>
        </div>

        <p class="text-dim mt-3 text-[0.9rem]">{d.download.featuredStatus}</p>

        <ul class="dl-trust">
          <li>{d.download.trustAndroid}</li>
          <li>{d.download.trustSigned}</li>
          <li>{d.download.trustFree}</li>
        </ul>
      </div>

      <div class="dl-stage">
        <span class="dl-halo" aria-hidden="true"></span>
        <span class="dl-ring" aria-hidden="true"></span>
        <span class="dl-ring-inner" aria-hidden="true"></span>
        <img
          class="dl-art"
          src="/img/download-hero-su.webp"
          width="880"
          height="880"
          alt={d.download.heroArtAlt}
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class="container pb-8">
    <h2>{d.download.appsH2}</h2>
    <p class="text-dim">{d.download.appsNote}</p>

    <div class="mt-5 grid gap-5 min-[720px]:grid-cols-3">
      {apps.map((app) => (
        <article
          class:list={['panel dl-card', app.featured && 'dl-card-featured']}
        >
          <div class="dl-card-art">
            <span class="dl-badge">{app.badge}</span>
            <img
              src={app.art}
              width="512"
              height="512"
              alt={app.alt}
              loading="lazy"
            />
          </div>
          <div class="dl-card-body">
            <h3>{app.name}</h3>
            <p class="dl-pkg">
              <span class="sr-only">{d.download.packageLabel}: </span>{app.pkg}
            </p>
            <ul class="dl-points">
              {app.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
            <a
              class="btn btn-primary mt-auto block text-center"
              href={app.href}
              data-apk-link
              data-apk-name={app.name}
              data-apk-file={app.file}
              data-rma-event={app.click}
              data-rma-event-detail={app.slug}
              >{d.download.downloadCta}</a
            >
            <p class="text-dim mb-0 mt-2 text-center font-mono text-[0.78rem]">{app.file}</p>
          </div>
        </article>
      ))}
    </div>

    <!-- Store chips — coming soon, client only (Rootz / Guardian Angel stay sideload-only) -->
    <div class="row mt-5 items-stretch gap-3">
      <span
        class="flex items-center gap-2 rounded-[0.5rem] border border-dashed border-line px-3 py-2 text-[0.85rem] text-dim"
        aria-disabled="true">
        <svg class="h-[1.15rem] w-[1.15rem] fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M8.8086 14.9194l6.1107-11.0368c.0837-.1513.1682-.302.2437-.4584.0685-.142.1267-.2854.1646-.4403.0803-.3259.0588-.6656-.066-.9767-.1238-.3095-.3417-.5678-.6201-.7355a1.4175 1.4175 0 0 0-.921-.1924c-.3207.043-.6135.1935-.8443.4288-.1094.1118-.1996.2361-.2832.369-.092.1463-.175.2979-.259.4492l-.3864.6979-.3865-.6979c-.0837-.1515-.1667-.303-.2587-.4492-.0837-.1329-.1739-.2572-.2835-.369-.2305-.2353-.5233-.3857-.844-.429a1.4181 1.4181 0 0 0-.921.1926c-.2784.1677-.4964.426-.6203.7355-.1246.311-.1461.6508-.066.9767.038.155.0962.2984.1648.4403.0753.1564.1598.307.2437.4584l1.248 2.2543-4.8625 8.7825H2.0295c-.1676 0-.3351-.0007-.5026.0092-.1522.009-.3004.0284-.448.0714-.3108.0906-.5822.2798-.7783.548-.195.2665-.3006.5929-.3006.9279 0 .3352.1057.6612.3006.9277.196.2683.4675.4575.7782.548.1477.043.296.0623.4481.0715.1675.01.335.009.5026.009h13.0974c.0171-.0357.059-.1294.1-.2697.415-1.4151-.6156-2.843-2.0347-2.843zM3.113 18.5418l-.7922 1.5008c-.0818.1553-.1644.31-.2384.4705-.067.1458-.124.293-.1611.452-.0785.3346-.0576.6834.0645 1.0029.1212.3175.3346.583.607.7549.2727.172.5891.2416.9013.1975.3139-.044.6005-.1986.8263-.4402.1072-.1148.1954-.2424.2772-.3787.0902-.1503.1714-.3059.2535-.4612L6 19.4636c-.0896-.149-.9473-1.4704-2.887-.9218m20.5861-3.0056a1.4707 1.4707 0 0 0-.779-.5407c-.1476-.0425-.2961-.0616-.4483-.0705-.1678-.0099-.3352-.0091-.503-.0091H18.648l-4.3891-7.817c-.6655.7005-.9632 1.485-1.0773 2.1976-.1655 1.0333.0367 2.0934.546 3.0004l5.2741 9.3933c.084.1494.167.299.2591.4435.0837.131.1739.2537.2836.364.231.2323.5238.3809.8449.4232.3192.0424.643-.0244.9217-.1899.2784-.1653.4968-.4204.621-.7257.1246-.3072.146-.6425.0658-.9641-.0381-.1529-.0962-.2945-.165-.4346-.0753-.1543-.1598-.303-.2438-.4524l-1.216-2.1662h1.596c.1677 0 .3351.0009.5029-.009.1522-.009.3007-.028.4483-.0705a1.4707 1.4707 0 0 0 .779-.5407A1.5386 1.5386 0 0 0 24 16.452a1.539 1.539 0 0 0-.3009-.9158Z"
          ></path>
        </svg>
        <span class="font-semibold">{d.download.appStoreName}</span>
        <span>{d.download.comingSoon}</span>
      </span>
      <span
        class="flex items-center gap-2 rounded-[0.5rem] border border-dashed border-line px-3 py-2 text-[0.85rem] text-dim"
        aria-disabled="true">
        <svg class="h-[1.15rem] w-[1.15rem] fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M22.018 13.298l-3.919 2.218-3.515-3.493 3.543-3.521 3.891 2.202a1.49 1.49 0 0 1 0 2.594zM1.337.924a1.486 1.486 0 0 0-.112.568v21.017c0 .217.045.419.124.6l11.155-11.087L1.337.924zm12.207 10.065l3.258-3.238L3.45.195a1.466 1.466 0 0 0-.946-.179l11.04 10.973zm0 2.067l-11 10.933c.298.036.612-.016.906-.183l13.324-7.54-3.23-3.21z"
          ></path>
        </svg>
        <span class="font-semibold">{d.download.playStoreName}</span>
        <span>{d.download.comingSoon}</span>
      </span>
    </div>
  </section>

  <section class="container pb-8">
    <div class="panel grid items-center gap-6 p-6 min-[720px]:grid-cols-[1fr_auto]">
      <div>
        <h2 class="mt-0">{d.download.startH2}</h2>
        <p class="muted m-0">{d.download.startP}</p>
      </div>
      <a class="btn btn-primary text-center" href={lp(locale, '/scan')}>{d.download.startCta}</a>
    </div>
  </section>

  <section class="container pb-12" id="install">
    <h2>{d.download.installH2}</h2>
    <ol class="dl-steps">
      <li class="dl-step">
        <span class="dl-step-num" aria-hidden="true">1</span>
        <p>{d.download.installStep1}</p>
      </li>
      <li class="dl-step">
        <span class="dl-step-num" aria-hidden="true">2</span>
        <p>{d.download.installStep2Before}<strong>{d.download.installStep2Strong}</strong>{d.download.installStep2After}</p>
      </li>
      <li class="dl-step">
        <span class="dl-step-num" aria-hidden="true">3</span>
        <p>{d.download.installStep3Before}<strong>{d.download.installStep3Strong}</strong>{d.download.installStep3After}</p>
      </li>
    </ol>

    <div class="panel mt-6">
      <h3 class="mt-0">{d.download.verifyH3}</h3>
      <p>{d.download.verifyP}</p>
      <div>
        <p class="m-0 text-[0.8rem] font-bold uppercase tracking-[0.06em] text-dim">
          {d.download.verifyCurrent}
        </p>
        <code class="dl-fingerprint">{KEY_CURRENT}</code>
      </div>
      <p class="text-dim mb-0 mt-4 text-[0.9rem]">{d.download.verifyNote}</p>
    </div>

    <p class="mt-5">
      {d.download.requiresBefore}<a href={RELEASES}>{d.download.requiresLink}</a>{d.download.requiresAfter}
    </p>
    <p class="text-dim">
      {d.download.previewNote}
    </p>
  </section>

  <!-- Sideloading modal (owner instruction 2026-11-13): intercepts every
       data-apk-link click and walks through the steps before the
       download starts. Hidden by default; src/scripts/downloads.ts
       toggles it. The Continue anchor carries the clicked link's href so
       the analytics auto-tracker still records the outbound download. -->
  <div
    id="sideload-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-page/85 p-4 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-labelledby="sideload-modal-title"
  >
    <div
      class="panel w-full max-w-[26rem] p-6 shadow-2xl"
      role="document"
    >
      <p class="m-0 flex items-center gap-2 text-[0.78rem] font-bold uppercase tracking-[0.08em] text-dim">
        <span>{d.download.sideloadApp}</span>
        <strong id="sideload-app" class="rounded-full border border-ok/45 bg-ok/12 px-[0.55rem] py-[0.1rem] text-[0.72rem] text-ok"></strong>
      </p>
      <h3 id="sideload-modal-title" class="mb-3 mt-2 text-[1.25rem]">{d.download.sideloadTitle}</h3>
      <ol class="mb-4 list-decimal space-y-2 pl-5 text-[0.92rem] leading-[1.5]">
        <li>{d.download.sideloadStep1}</li>
        <li>{d.download.sideloadStep2}</li>
        <li>{d.download.sideloadStep3}</li>
      </ol>
      <p class="text-dim mb-5 text-[0.88rem]">{d.download.sideloadNote}</p>
      <div class="row items-center justify-end gap-3">
        <button
          id="sideload-cancel"
          class="btn"
          type="button">{d.download.sideloadCancel}</button
        >
        <a
          id="sideload-continue"
          class="btn btn-primary"
          href={apps[0].href}
          data-rma-event="download"
          >{d.download.sideloadContinue}</a
        >
      </div>
    </div>
  </div>

  <script>
    import '../../scripts/analytics.ts'
    import '../../scripts/downloads.ts'
  </script>
</Base>
