fetch-timeout=900000
fetch-retries=10
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=180000
socket-timeout=900000

# Owner ruling 2026-11-08: NO package may be installed un-pinned.
# `pnpm add` writes EXACT versions (no ^/~ ranges); the CI gate
# tools/check-pinned-versions.mjs rejects any ranged specifier.
save-exact=true
